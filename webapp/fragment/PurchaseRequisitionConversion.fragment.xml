<!-- Fragment PurchaseRequisitionConversion.fragment: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog
    id="purchaseRequisitionConversionDialog"
    title="Create Purchase Order from Selected Requisitions"
    contentWidth="48rem"
    stretchOnPhone="true"
    busy="{mrp>/busy}"
    busyIndicatorDelay="0">
    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip
          text="One Purchase Order will be created for all selected requisitions. Enter a Net Price greater than zero for every material before creating the Purchase Order."
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom" />
        <f:SimpleForm
          editable="true"
          layout="ResponsiveGridLayout"
          labelSpanXL="4"
          labelSpanL="4"
          labelSpanM="4"
          labelSpanS="12"
          columnsXL="2"
          columnsL="2"
          columnsM="1">
          <Label text="Selected Requisitions" />
          <Input value="{prConvert>/selectedCount}" editable="false" />

          <Label text="Delivery Date" required="true" />
          <DatePicker
            value="{prConvert>/deliveryDate}"
            valueFormat="yyyy-MM-dd"
            displayFormat="medium" />

          <Label text="Plant" required="true" />
          <Input value="{prConvert>/plant}" editable="false" />

          <Label text="Storage Location" required="true" />
          <Input value="{prConvert>/storageLocation}" maxLength="4" />

          <Label text="Purchasing Organization" required="true" />
          <Input
            value="{prConvert>/purchOrg}"
            description="{prConvert>/purchOrgName}"
            showValueHelp="true"
            valueHelpRequest="onPRPurchOrgValueHelp" />

          <Label text="Company Code" required="true" />
          <Input value="{prConvert>/companyCode}" maxLength="4" />

          <Label text="Vendor" required="true" />
          <Input
            value="{prConvert>/vendor}"
            description="{prConvert>/vendorName}"
            showValueHelp="true"
            valueHelpRequest="onPRVendorValueHelp" />

          <Label text="Purchasing Group" required="true" />
          <Input
            value="{prConvert>/purchGroup}"
            description="{prConvert>/purchGroupName}"
            showValueHelp="true"
            valueHelpRequest="onPRPurchGroupValueHelp" />

        </f:SimpleForm>

        <Table
          class="sapUiSmallMarginTop"
          items="{prConvert>/items}">
          <columns>
            <Column><Text text="PR" /></Column>
            <Column><Text text="Material" /></Column>
            <Column hAlign="End"><Text text="Quantity" /></Column>
            <Column hAlign="End"><Text text="Net Price" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{prConvert>purchaseRequisition}" />
                <Text text="{prConvert>material}" />
                <ObjectNumber number="{prConvert>quantity}" unit="{prConvert>unit}" />
                <HBox alignItems="Center" justifyContent="End">
                  <Input
                    value="{prConvert>price}"
                    type="Number"
                    textAlign="End"
                    width="8rem" />
                  <Text text="{prConvert>currency}" class="sapUiTinyMarginBegin" />
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
    <beginButton>
      <Button
        id="submitPRConversionButton"
        text="Create Purchase Order"
        type="Emphasized"
        press="onSubmitPRConversion" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press="onClosePRConversion" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
