<!-- Fragment ProductionOperationConfirmation.fragment: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog
    id="productionOperationConfirmationDialog"
    title="Confirm Production Operation"
    contentWidth="38rem"
    stretchOnPhone="true">
    <content>
      <VBox class="sapUiSmallMargin">
        <ObjectIdentifier
          id="confirmationOrderIdentifier"
          title="Production Order"
          text="" />
        <f:SimpleForm
          editable="true"
          layout="ResponsiveGridLayout"
          labelSpanXL="4"
          labelSpanL="4"
          labelSpanM="4"
          labelSpanS="12"
          columnsXL="1"
          columnsL="1"
          columnsM="1">
          <Label text="Operation" required="true" />
          <Input id="confirmationOperationInput" value="0010" editable="false" />
          <Label text="Yield Quantity" required="true" />
          <Input id="confirmationYieldInput" type="Number" />
          <Label text="Scrap Quantity" />
          <Input id="confirmationScrapInput" type="Number" value="0" />
          <Label text="Unit" required="true" />
          <Input id="confirmationUnitInput" maxLength="3" />
          <Label text="Confirmation Type" />
          <CheckBox id="confirmationFinalCheckBox" text="Final confirmation" selected="true" />
        </f:SimpleForm>
      </VBox>
    </content>
    <beginButton>
      <Button
        id="submitProductionConfirmationButton"
        text="Confirm"
        type="Emphasized"
        press="onSubmitOperationConfirmation" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press="onCloseOperationConfirmation" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
