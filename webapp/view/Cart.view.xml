<!-- View Cart.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
    controllerName="sap490g7fioriapp.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <!-- Trang chính: Cart -->
    <Page title="Cart" showFooter="true" showNavButton="true" navButtonPress=".onBack">
        <content>
            <Table
                id="cartList"
                items="{
                    path: '/CartItems',
                    parameters: {
                        $expand: '_Food($select=MaterialNumber,MaterialDescription,ImageUrl)'
                    }
                }"
                updateFinished=".onCartListUpdateFinished"
                noDataText="Your cart is empty"
                class="cartTable">
                <columns>
                    <Column hAlign="Center" width="8%"><Text text="Image" /></Column>
                    <Column width="32%"><Text text="Material" /></Column>
                    <Column hAlign="End" width="15%"><Text text="Unit Price" /></Column>
                    <Column hAlign="Center" width="12%"><Text text="Quantity" /></Column>
                    <Column hAlign="End" width="18%"><Text text="Line Amount" /></Column>
                    <Column hAlign="Center" width="10%"><Text text="" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Avatar
                                src="{_Food/ImageUrl}"
                                fallbackIcon="sap-icon://meal"
                                displayShape="Square"
                                displaySize="Custom"
                                customDisplaySize="3.5rem"
                                customFontSize="1.25rem"
                                class="cartItemImage" />
                            <ObjectIdentifier
                                title="{parts: [{path: '_Food/MaterialDescription'}, {path: 'FoodID'}], formatter: '.formatFoodName'}"
                                text="{FoodID}" />
                            <Text text="{parts: [{path: 'UnitPrice'}, {path: 'Currency'}], formatter: '.formatCartAmount'}" />
                            <StepInput
                                value="{Quantity}"
                                min="1"
                                step="1"
                                width="7rem"
                                change=".onQuantityChange" />
                            <Text text="{parts: [{path: 'LineAmount'}, {path: 'Currency'}], formatter: '.formatCartAmount'}" class="sapMTextBold" />
                            <Button icon="sap-icon://decline" tooltip="Remove" type="Reject" press=".onRemoveCartItem" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Toolbar class="cartFooter">
                <ToolbarSpacer />
                <VBox alignItems="End" class="sapUiTinyMarginEnd">
                    <Text text="Total" class="sapUiTinyMarginBottom" />
                    <Title text="{cartView>/totalPriceFormatted}" level="H3" />
                </VBox>
                <Button
                    text="Checkout"
                    type="Emphasized"
                    icon="sap-icon://cart"
                    enabled="{cartView>/checkoutEnabled}"
                    busy="{cartView>/checkoutBusy}"
                    press=".onCheckout" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
