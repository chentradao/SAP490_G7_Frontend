<mvc:View
    controllerName="sap490g7fioriapp.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <Page title="Cart" showFooter="true">
        <headerContent>
            <Button icon="sap-icon://nav-back" text="Back" press=".onBack" />
        </headerContent>
        <content>
            <Table
                id="cartList"
                items="{path: '/CartItems'}"
                updateFinished=".onCartListUpdateFinished"
                noDataText="Your cart is empty"
                class="cartTable">
                <columns>
                    <Column width="45%"><Text text="Material" /></Column>
                    <Column hAlign="End" width="15%"><Text text="Unit Price" /></Column>
                    <Column hAlign="Center" width="12%"><Text text="Quantity" /></Column>
                    <Column hAlign="End" width="18%"><Text text="Line Amount" /></Column>
                    <Column hAlign="Center" width="10%"><Text text="" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier
                                title="{parts: [{path: 'FoodID'}, {path: 'cartNames>/'}], formatter: '.formatFoodName'}"
                                text="{FoodID}" />
                            <Text text="{parts: [{path: 'UnitPrice'}, {path: 'Currency'}], formatter: '.formatUnitPrice'}" />
                            <StepInput
                                value="{Quantity}"
                                min="1"
                                step="1"
                                width="7rem"
                                change=".onQuantityChange" />
                            <Text text="{parts: [{path: 'UnitPrice'}, {path: 'Quantity'}, {path: 'Currency'}], formatter: '.formatLineAmount'}" class="sapMTextBold" />
                            <Button icon="sap-icon://decline" tooltip="Remove" type="Reject" press=".onRemoveCartItem" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Toolbar class="cartFooter">
                <ToolbarSpacer />
                <VBox alignItems="End" class="sapUiTinyMarginEnd">
                    <Text text="Tổng cộng" class="sapUiTinyMarginBottom" />
                    <Title text="{cartView>/totalPriceFormatted}" level="H3" />
                </VBox>
                <Button
                    text="Checkout"
                    type="Emphasized"
                    icon="sap-icon://cart"
                    enabled="{cartView>/checkoutEnabled}"
                    busy="{cartView>/checkoutBusy}"
                    press=".onCheckout" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
