<!-- View PIRPlanning.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
  controllerName="sap490g7fioriapp.controller.PIRPlanning"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  displayBlock="true">

  <!-- Trang chính: Demand Forecast and PIR -->
  <Page title="Demand Forecast and PIR" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>
    <content>
      <VBox class="poHistoryShell">
        <HBox class="poHistoryHero" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox class="poHistoryHeroText">
            <Title text="Tomorrow's Meal Forecast" level="H2" />
            <Text text="Select multiple finished meals, enter each forecast quantity, then create all Planned Independent Requirements in one step." class="poHistorySubtitle" />
          </VBox>
          <ObjectStatus text="Strategy 40 · VSF · Version 00" icon="sap-icon://business-objects-experience" state="Information" />
        </HBox>

        <MessageStrip
          text="Demo flow: Select meals → enter each demand quantity → Create PIR batch → Run total MRP once → review procurement and production proposals."
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <HBox wrap="Wrap" alignItems="Stretch" class="pirPlanningWorkspace">
        <!-- Khu vực nghiệp vụ: 1. Choose a Meal -->
        <Panel headerText="1. Choose a Meal" class="staffWorkflowPanel pirPlanningColumn">
          <content>
            <SearchField
              width="100%"
              placeholder="Search meal code or description"
              liveChange="onFinishedGoodsSearch"
              class="sapUiTinyMarginBottom" />
            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true" class="wideTableScroll">
              <Table
                id="pirFinishedGoodsTable"
                class="wideDataTableMD"
                mode="MultiSelect"
                selectionChange="onFinishedGoodSelected"
                growing="true"
                growingThreshold="10"
                noDataText="No finished goods found in FG01"
                items="{path: '/FinishedGoodsStock', filters: [{path: 'Material', operator: 'GE', value1: 'FG00009'}]}">
                <columns>
                  <Column width="11rem"><Text text="Material" /></Column>
                  <Column width="18rem"><Text text="Description" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Current FG Stock" /></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active">
                    <cells>
                      <ObjectIdentifier title="{Material}" text="{MaterialBaseUnit}" />
                      <Text text="{MaterialDescription}" />
                      <ObjectNumber number="{StockQuantity}" unit="{MaterialBaseUnit}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>

        <!-- Khu vực nghiệp vụ: 2. Plan Tomorrow's Demand -->
        <Panel headerText="2. Plan Tomorrow's Demand" class="staffWorkflowPanel pirPlanningColumn">
          <content>
            <VBox class="sapUiSmallMargin">
              <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                columnsXL="2"
                columnsL="2"
                columnsM="1">
                <Label text="Requirement Date" required="true" />
                <DatePicker
                  value="{pir>/requirementDate}"
                  valueFormat="yyyy-MM-dd"
                  displayFormat="medium"
                  minDate="{pir>/minimumDate}" />

              </f:SimpleForm>

              <Table
                id="pirSelectedMealsTable"
                class="sapUiSmallMarginTop"
                noDataText="Select one or more meals from the table on the left"
                items="{pir>/selectedMeals}">
                <columns>
                  <Column width="8rem"><Text text="Material" /></Column>
                  <Column width="11rem"><Text text="Meal" /></Column>
                  <Column width="8rem" hAlign="End"><Text text="Current Stock" /></Column>
                  <Column width="10rem"><Text text="Forecast Quantity" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <ObjectIdentifier title="{pir>material}" />
                      <Text text="{pir>description}" />
                      <ObjectNumber number="{pir>currentStock}" unit="{pir>unit}" />
                      <Input value="{pir>quantity}" type="Number" description="{pir>unit}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>

              <ObjectStatus
                text="SAP parameters: P001 · VSF · Version 00 (Active)"
                icon="sap-icon://settings"
                state="Information"
                class="sapUiSmallMarginBegin sapUiSmallMarginTop" />

              <Toolbar>
                <ToolbarSpacer />
                <Button
                  id="createPIRButton"
                  text="Create Forecasts (PIR)"
                  icon="sap-icon://add-document"
                  type="Emphasized"
                  press="onCreatePIR"
                  enabled="{= ${pir>/selectedMeals}.length > 0 &amp;&amp; !${pir>/busy} }" />
              </Toolbar>
            </VBox>
          </content>
        </Panel>
        </HBox>

        <Panel
          headerText="Previous Forecasts and MRP Runs"
          expandable="true"
          expanded="false"
          class="staffWorkflowPanel sapUiMediumMarginTop">
        <ScrollContainer width="100%" height="34vh" horizontal="true" vertical="true" focusable="true" class="wideTableScroll">
          <List
            id="pirHistoryList"
            class="poHistoryTable wideDataTable"
            sticky="ColumnHeaders"
            alternateRowColors="true"
            growing="true"
            growingThreshold="20"
            noDataText="No PIR requests found"
            items="{pir>/historyBatches}">
            <items>
              <CustomListItem>
                <Panel expandable="true" expanded="false" class="sapUiTinyMarginBottom">
                  <headerToolbar>
                    <Toolbar>
                      <Title text="Forecast Batch {pir>batchId}" level="H5" />
                      <Text text="{pir>summary}" class="sapUiSmallMarginBegin" />
                      <ToolbarSpacer />
                      <Button text="Run Total MRP" icon="sap-icon://process" type="Emphasized" press="onRunHistoryBatch" enabled="{= !!${pir>requestId} &amp;&amp; !${pir>/busy} }" />
                    </Toolbar>
                  </headerToolbar>
                  <content>
                    <Table items="{pir>items}" inset="false">
                      <columns>
                        <Column><Text text="Material" /></Column>
                        <Column><Text text="Requirement Date" /></Column>
                        <Column hAlign="End"><Text text="Quantity" /></Column>
                        <Column><Text text="Status" /></Column>
                        <Column><Text text="SAP Message" /></Column>
                        <Column width="9rem" hAlign="Center"><Text text="Action" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem highlight="{path: 'pir>status', formatter: '.formatHighlight'}">
                          <cells>
                            <ObjectIdentifier title="{pir>material}" text="{pir>pir_request_id}" />
                            <Text text="{path: 'pir>requirement_date', formatter: '.formatDate'}" />
                            <ObjectNumber number="{pir>requirement_quantity}" unit="{pir>unit}" />
                          <ObjectStatus text="{pir>status}" state="{path: 'pir>status', formatter: '.formatState'}" />
                          <Text text="{pir>bapi_message}" wrapping="true" maxLines="2" />
                          <Button text="Run MRP" icon="sap-icon://process" press="onRunSingleMRP" enabled="{= (${pir>status} === 'CREATED' || ${pir>status} === 'MRP_ERROR') &amp;&amp; !${pir>/busy} }" />
                          </cells>
                        </ColumnListItem>
                      </items>
                    </Table>
                  </content>
                </Panel>
              </CustomListItem>
            </items>
          </List>
        </ScrollContainer>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
