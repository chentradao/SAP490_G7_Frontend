<!-- View POHistory.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
  controllerName="sap490g7fioriapp.controller.POHistory"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  displayBlock="true">

  <Page
    title="PO History"
    showNavButton="true"
    navButtonPress="onNavBack"
    backgroundDesign="Standard">

    <headerContent>
      <Button
        text="GR History"
        icon="sap-icon://history"
        type="Transparent"
        press="onOpenGRHistory" />
    </headerContent>

    <content>
      <VBox class="poHistoryShell">
        <Panel
          visible="{poSuccess>/visible}"
          class="poHistorySuccessPanel"
          backgroundDesign="Solid">
          <content>
            <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
              <HBox alignItems="Center">
                <core:Icon src="sap-icon://message-success" size="2rem" color="#188918" class="sapUiSmallMarginEnd" />
                <VBox>
                  <Title text="Purchase Order Created Successfully" level="H2" />
                  <Text text="The selected raw materials were grouped into one Purchase Order." />
                </VBox>
              </HBox>
              <VBox alignItems="End" class="sapUiSmallMarginBegin">
                <Label text="Purchase Order" />
                <ObjectIdentifier title="{poSuccess>/purchaseOrder}" />
                <Text text="{poSuccess>/materialCount} material(s) • Vendor {poSuccess>/vendor} • {poSuccess>/batchCode}" />
              </VBox>
            </HBox>
          </content>
        </Panel>

        <HBox
          class="poHistoryHero"
          justifyContent="SpaceBetween"
          alignItems="Center"
          wrap="Wrap">
          <VBox class="poHistoryHeroText">
            <Title text="Purchase Order History" level="H2" />
            <Text
              text="Track purchasing requests, SAP document numbers and processing messages."
              class="poHistorySubtitle" />
          </VBox>
          <ObjectStatus
            text="SAP S/4HANA"
            icon="sap-icon://database"
            state="Information"
            class="poHistorySystemBadge" />
        </HBox>

        <OverflowToolbar class="poHistoryFilterBar">
          <SearchField
            id="poHistorySearch"
            width="22rem"
            placeholder="Search PO, batch, material or vendor"
            search="onSearch"
            liveChange="onSearch" />
          <Select
            id="poStatusFilter"
            width="11rem"
            selectedKey="ALL"
            change="onStatusChange">
            <core:Item key="ALL" text="All Statuses" />
            <core:Item key="OPEN" text="Open" />
            <core:Item key="PARTIALLY_RECEIVED" text="Partially Received" />
            <core:Item key="FULLY_RECEIVED" text="Fully Received" />
            <core:Item key="PENDING" text="Pending" />
            <core:Item key="ERROR" text="Error" />
          </Select>
          <ToolbarSpacer />
          <Button
            text="Clear"
            icon="sap-icon://clear-filter"
            type="Transparent"
            press="onClearFilters" />
          <Button
            text="Refresh"
            icon="sap-icon://refresh"
            type="Transparent"
            press="onRefresh" />
        </OverflowToolbar>

        <ScrollContainer width="100%" height="58vh" horizontal="true" vertical="true" focusable="true" class="wideTableScroll">
          <List
            id="poHistoryList"
            busy="{poGroups>/busy}"
            showSeparators="None"
            noDataText="No purchase orders match the selected filters"
            items="{poGroups>/groups}">
            <CustomListItem>
              <Panel expandable="true" expanded="{poGroups>expanded}" class="staffWorkflowPanel sapUiSmallMarginBottom">
                <headerToolbar>
                  <OverflowToolbar>
                    <Title text="PO {poGroups>purchaseOrder}" level="H3" />
                    <ObjectStatus text="{poGroups>statusText}" state="{poGroups>statusState}" />
                    <Button
                      text="{= ${poGroups>remainingItemCount} > 0 ? 'GR Entire PO' : 'GR Completed' }"
                      icon="sap-icon://shipping-status"
                      type="{= ${poGroups>remainingItemCount} > 0 ? 'Emphasized' : 'Transparent' }"
                      press="onPostBatchGR"
                      visible="{= !!${poGroups>purchaseOrder} }"
                      enabled="{= ${poGroups>remainingItemCount} > 0 &amp;&amp; !${poGroups>/busy} }" />
                    <Text text="{poGroups>itemCount} item(s) • Vendor {poGroups>vendor} • {poGroups>batchCode}" />
                    <ToolbarSpacer />
                  </OverflowToolbar>
                </headerToolbar>
                <content>
                  <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true">
                    <Table
                      width="92rem"
                      class="poHistoryTable wideDataTable"
                      alternateRowColors="true"
                      items="{poGroups>items}">
                    <columns>
                      <Column width="7rem"><Text text="PO Item" /></Column>
                      <Column width="11rem"><Text text="Source PR" /></Column>
                      <Column width="11rem"><Text text="Material" /></Column>
                      <Column width="15rem"><Text text="Description" /></Column>
                      <Column width="9rem" hAlign="End"><Text text="Ordered" /></Column>
                      <Column width="9rem" hAlign="End"><Text text="Received" /></Column>
                      <Column width="9rem" hAlign="End"><Text text="Remaining" /></Column>
                      <Column width="8rem"><Text text="Location" /></Column>
                      <Column width="8rem"><Text text="Action" /></Column>
                    </columns>
                    <items>
                      <ColumnListItem highlight="{= ${poGroups>remaining_quantity} > 0 ? 'Information' : 'Success' }">
                        <cells>
                          <ObjectIdentifier title="{poGroups>purchase_order_item}" />
                          <ObjectIdentifier title="{poGroups>purchase_requisition}" text="Item {poGroups>purchase_requisition_item}" />
                          <ObjectIdentifier title="{poGroups>material}" />
                          <Text text="{poGroups>material_description}" />
                          <ObjectNumber number="{poGroups>ordered_quantity}" unit="{poGroups>unit}" />
                          <ObjectNumber number="{poGroups>received_quantity}" unit="{poGroups>unit}" />
                          <ObjectNumber number="{poGroups>remaining_quantity}" unit="{poGroups>unit}" state="{= ${poGroups>remaining_quantity} > 0 ? 'Warning' : 'Success' }" />
                          <ObjectIdentifier title="{poGroups>plant}" text="{poGroups>storage_loc}" />
                          <Button
                            text="{= ${poGroups>remaining_quantity} > 0 ? 'GR Item' : 'GR Completed' }"
                            icon="sap-icon://shipping-status"
                            press="onOpenSingleGR"
                            enabled="{= ${poGroups>remaining_quantity} > 0 &amp;&amp; !!${poGroups>purchase_order_item} &amp;&amp; !${poGroups>/busy} }" />
                        </cells>
                      </ColumnListItem>
                    </items>
                    </Table>
                  </ScrollContainer>
                </content>
              </Panel>
            </CustomListItem>
          </List>
        </ScrollContainer>
      </VBox>
    </content>

    <dependents>
      <Dialog
        id="poDetailsDialog"
        title="Purchase Order Details"
        contentWidth="42rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true">
        <content>
          <VBox class="poDetailsContent">
            <HBox class="poDetailsHeader" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
              <VBox>
                <Label text="SAP Purchase Order" />
                <Title text="{= ${purchase_order} || 'Not generated' }" level="H3" />
                <Text text="{request_id}" />
              </VBox>
              <ObjectStatus
                text="{parts: ['purchase_order', 'status'], formatter: '.formatStatus'}"
                state="{parts: ['purchase_order', 'status'], formatter: '.formatStatusState'}"
                inverted="true" />
            </HBox>

            <f:SimpleForm
              editable="false"
              layout="ResponsiveGridLayout"
              labelSpanXL="4"
              labelSpanL="4"
              labelSpanM="4"
              labelSpanS="12"
              columnsXL="2"
              columnsL="2"
              columnsM="1">
              <Label text="Material" /><ObjectIdentifier title="{material}" text="{material_description}" />
              <Label text="Source" /><ObjectStatus text="{path: 'purchase_requisition', formatter: '.formatPurchaseSource'}" state="Information" />
              <Label text="Purchase Requisition" />
              <ObjectIdentifier
                title="{= ${purchase_requisition} || '-' }"
                text="{= ${purchase_requisition_item} ? 'Item ' + ${purchase_requisition_item} : '' }" />
              <Label text="Vendor" /><ObjectIdentifier title="{vendor}" text="{vendor_name}" />
              <Label text="Quantity" /><ObjectNumber number="{quantity}" unit="{unit}" />
              <Label text="Unit Price" /><ObjectNumber number="{path: 'price', formatter: '.formatPrice'}" unit="{currency}" />
              <Label text="Total Amount" />
              <ObjectNumber
                number="{parts: ['quantity', 'price'], formatter: '.formatTotalAmount'}"
                unit="{currency}"
                emphasized="true" />
              <Label text="Company Code" /><Text text="{company_code}" />
              <Label text="Plant" /><Text text="{plant}" />
              <Label text="Storage Location" /><Text text="{storage_loc}" />
              <Label text="Purchasing Organization" /><Text text="{purch_org}" />
              <Label text="Purchasing Group" /><Text text="{purch_group}" />
              <Label text="Delivery Date" /><Text text="{path: 'delivery_date', formatter: '.formatDate'}" />
              <Label text="Created By" /><Text text="{created_by}" />
              <Label text="Created At" /><Text text="{path: 'created_at', formatter: '.formatDateTime'}" />
              <Label text="Updated By" /><Text text="{updated_by}" />
              <Label text="Updated At" /><Text text="{path: 'updated_at', formatter: '.formatDateTime'}" />
            </f:SimpleForm>

            <MessageStrip
              text="{= ${bapi_message} || 'No processing message returned by SAP.' }"
              type="Information"
              showIcon="true"
              showCloseButton="false"
              class="sapUiSmallMarginTop" />
          </VBox>
        </content>
        <endButton>
          <Button text="Close" press="onClosePODetails" />
        </endButton>
        <beginButton>
          <Button
            text="Receive Goods"
            icon="sap-icon://shipping-status"
            type="Emphasized"
            visible="{= !!${purchase_order} }"
            press="onOpenGRDialog" />
        </beginButton>
      </Dialog>

      <Dialog
        id="postGRDialog"
        title="Post Goods Receipt"
        contentWidth="38rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
        busy="{gr>/busy}">
        <content>
          <VBox class="poDetailsContent">
            <MessageStrip
              text="Goods receipt will be posted with movement type 101 and will increase SAP stock."
              type="Information"
              showIcon="true"
              showCloseButton="false" />

            <HBox class="poDetailsHeader sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
              <VBox>
                <Label text="Purchase Order" />
                <Title text="{gr>/purchaseOrder}" level="H4" />
                <Text text="{= ${gr>/material} + ' · Item ' + ${gr>/purchaseOrderItem} }" />
              </VBox>
              <ObjectStatus text="Movement 101" state="Information" />
            </HBox>

            <HBox
              justifyContent="SpaceAround"
              alignItems="Center"
              wrap="Wrap"
              class="sapUiSmallMarginTop sapUiSmallMarginBottom">
              <VBox alignItems="Center" class="sapUiTinyMarginBeginEnd">
                <Label text="Ordered" />
                <ObjectNumber number="{gr>/orderedQuantity}" unit="{gr>/unit}" />
              </VBox>
              <VBox alignItems="Center" class="sapUiTinyMarginBeginEnd">
                <Label text="Received" />
                <ObjectNumber number="{gr>/receivedQuantity}" unit="{gr>/unit}" />
              </VBox>
              <VBox alignItems="Center" class="sapUiTinyMarginBeginEnd">
                <Label text="Remaining" />
                <ObjectNumber
                  number="{gr>/remainingQuantity}"
                  unit="{gr>/unit}"
                  state="{path: 'gr>/remainingQuantity', formatter: '.formatRemainingState'}"
                  emphasized="true" />
              </VBox>
            </HBox>

            <f:SimpleForm
              editable="true"
              layout="ResponsiveGridLayout"
              labelSpanXL="4"
              labelSpanL="4"
              labelSpanM="4"
              labelSpanS="12"
              columnsXL="1"
              columnsL="1"
              columnsM="1"
              class="sapUiSmallMarginTop">
              <Label text="Material" /><ObjectIdentifier title="{gr>/material}" text="{gr>/materialDescription}" />
              <Label text="Receiving Location" /><Text text="{= ${gr>/plant} + ' / ' + ${gr>/storageLoc} }" />
              <Label text="Quantity Received" required="true" />
              <Input
                value="{gr>/quantity}"
                type="Number"
                description="{gr>/unit}"
                enabled="{= ${gr>/remainingQuantity} > 0 &amp;&amp; !${gr>/busy} }"
                placeholder="Enter received quantity" />
              <Label text="Posting Date" required="true" />
              <DatePicker
                value="{gr>/postingDate}"
                valueFormat="yyyy-MM-dd"
                displayFormat="medium"
                minDate="{gr>/minimumPostingDate}" />
              <Label text="Document Date" required="true" />
              <DatePicker
                value="{gr>/documentDate}"
                valueFormat="yyyy-MM-dd"
                displayFormat="medium"
                minDate="{gr>/minimumPostingDate}" />
            </f:SimpleForm>
          </VBox>
        </content>
        <beginButton>
          <Button
            text="Post Goods Receipt"
            icon="sap-icon://accept"
            type="Emphasized"
            press="onPostGRConfirm"
            enabled="{= !${gr>/busy} }" />
        </beginButton>
        <endButton>
          <Button
            text="Cancel"
            press="onCloseGRDialog"
            enabled="{= !${gr>/busy} }" />
        </endButton>
      </Dialog>
    </dependents>
  </Page>
</mvc:View>
