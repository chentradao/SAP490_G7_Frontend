<mvc:View
    controllerName="sap490g7fioriapp.controller.FoodDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">
    <Page title="{i18n>foodDetailTitle}" showNavButton="true" navButtonPress=".onNavBack" fitContainer="true">
        <content>
            <VBox class="sapUiSmallMargin" width="100%">

                <ObjectHeader
                    title="{MaterialDescription}"
                    icon="{ImageUrl}"
                    number="{Price}"
                    numberUnit="{Currency}">
                    <attributes>
                        <ObjectAttribute title="{i18n>labelMaterialNumber}" text="{MaterialNumber}" />
                        <ObjectAttribute title="{i18n>labelMaterialGroup}" text="{MaterialGroup}" />
                        <ObjectAttribute title="{i18n>labelMaterialType}" text="{MaterialType}" />
                        <ObjectAttribute title="{i18n>labelStock}" text="{= ${AvailableStock} + ' ' + ${BaseUnit} }" />
                        <ObjectAttribute title="{i18n>labelPlant}" text="{= ${Plant} + ' / ' + ${StorageLocation} }" />
                    </attributes>
                    <statuses>
                        <ObjectStatus
                            text="{= ${Status} === 'A' ? ${i18n>statusActive} : ${i18n>statusInactive} }"
                            state="{= ${Status} === 'A' ? 'Success' : 'None' }" />
                    </statuses>
                </ObjectHeader>

                <Panel
                    headerText="Order Options"
                    class="sapUiSmallMarginTop">

                    <VBox class="sapUiSmallMargin">

                        <Label text="Quantity" />
                        <StepInput
                            id="quantityInput"
                            min="1"
                            max="{AvailableStock}"
                            value="1"
                            width="200px" />

                        <HBox class="sapUiSmallMarginTop">
                            <Button
                                text="Add to Cart"
                                type="Emphasized"
                                icon="sap-icon://cart"
                                enabled="{= (${Status} === 'A' || ${Status} === 'ACTIVE' || ${Status} === '1') &amp;&amp; ${AvailableStock} > 0 }"
                                press=".onAddToCart" />
                            <Button
                                text="View Cart"
                                icon="sap-icon://cart"
                                class="sapUiSmallMarginBegin"
                                press=".onOpenCart" />
                            <Button
                                text="Back to Menu"
                                class="sapUiSmallMarginBegin"
                                press=".onNavBack" />
                        </HBox>

                    </VBox>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
