<!-- View FoodDetail.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
    controllerName="sap490g7fioriapp.controller.FoodDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">
    <!-- Trang chính: {i18n>foodDetailTitle} -->
    <Page title="{i18n>foodDetailTitle}" showNavButton="true" navButtonPress=".onNavBack" fitContainer="true">
        <content>
            <VBox class="sapUiSmallMargin" width="100%">
                <HBox class="foodDetailHero" alignItems="Center" wrap="Wrap" width="100%">
                    <Avatar
                        src="{ImageUrl}"
                        fallbackIcon="sap-icon://meal"
                        displayShape="Square"
                        displaySize="Custom"
                        customDisplaySize="18rem"
                        customFontSize="5rem"
                        tooltip="{MaterialDescription}"
                        class="foodDetailImage" />

                    <VBox class="foodDetailInfo">
                        <ObjectHeader
                            title="{MaterialDescription}"
                            number="{path: 'Price', formatter: '.formatPrice'}"
                            numberUnit="{Currency}">
                            <attributes>
                                <ObjectAttribute title="{i18n>labelMaterialNumber}" text="{MaterialNumber}" />
                                <ObjectAttribute title="{i18n>labelMaterialGroup}" text="{MaterialGroup}" />
                                <ObjectAttribute title="{i18n>labelMaterialType}" text="{MaterialType}" />
                                <ObjectAttribute title="{i18n>labelStock}" text="{= ${AvailableStock} + ' ' + ${BaseUnit} }" />
                                <ObjectAttribute title="{i18n>labelPlant}" text="{= ${Plant} + ' / ' + ${StorageLocation} }" />
                            </attributes>
                            <statuses>
                                <ObjectStatus
                                    text="{= ${Status} === 'A' ? ${i18n>statusActive} : ${i18n>statusInactive} }"
                                    state="{= ${Status} === 'A' ? 'Success' : 'Error' }" />
                            </statuses>
                        </ObjectHeader>
                    </VBox>
                </HBox>

                <Panel
                    headerText="Order Options"
                    class="sapUiSmallMarginTop">

                    <VBox class="sapUiSmallMargin">

                        <Label text="Quantity" />
                        <StepInput
                            id="quantityInput"
                            min="1"
                            max="{AvailableStock}"
                            value="1"
                            width="200px" />

                        <HBox class="sapUiSmallMarginTop">
                            <Button
                                text="Add to Cart"
                                type="Emphasized"
                                icon="sap-icon://cart"
                                enabled="{= ${Status} === 'A' &amp;&amp; ${AvailableStock} > 0 }"
                                press=".onAddToCart" />
                            <Button
                                text="View Cart"
                                icon="sap-icon://cart"
                                class="sapUiSmallMarginBegin"
                                press=".onOpenCart" />
                            <Button
                                text="Back to Menu"
                                class="sapUiSmallMarginBegin"
                                press=".onNavBack" />
                        </HBox>

                    </VBox>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
