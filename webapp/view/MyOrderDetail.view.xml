<mvc:View
    controllerName="sap490g7fioriapp.controller.MyOrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <Page title="Order Detail" showNavButton="true" navButtonPress=".onBack" showFooter="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <ObjectHeader
                    title="{= 'Order ' + ${orders>/selectedOrder/orderId} }"
                    number="{orders>/selectedOrder/totalAmountText}"
                    numberUnit="{orders>/selectedOrder/currency}"
                    intro="{= 'Date ' + ${orders>/selectedOrder/orderDateDisplay} + ' ' + ${orders>/selectedOrder/orderTime} }"
                    backgroundDesign="Solid">
                    <attributes>
                        <ObjectAttribute title="Order Status" text="{orders>/selectedOrder/orderStatus}" />
                        <ObjectAttribute title="Payment Status" text="{orders>/selectedOrder/paymentStatus}" />
                    </attributes>
                </ObjectHeader>

                <Panel headerText="Order Information" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Order ID" />
                            <Text text="{orders>/selectedOrder/orderId}" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Note" />
                            <Text text="{orders>/selectedOrder/note}" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="Order Items" class="sapUiSmallMarginTop">
                    <Table items="{orders>/selectedOrder/items}" class="orderItemsTable">
                        <columns>
                            <Column hAlign="Center" width="10%"><Text text="Image" /></Column>
                            <Column width="28%"><Text text="Product" /></Column>
                            <Column hAlign="End" width="18%"><Text text="Unit Price" /></Column>
                            <Column hAlign="Center" width="12%"><Text text="Quantity" /></Column>
                            <Column hAlign="End" width="20%"><Text text="Line Amount" /></Column>
                            <Column width="12%"><Text text="Status" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <Avatar
                                        src="{orders>imageUrl}"
                                        fallbackIcon="sap-icon://meal"
                                        displayShape="Square"
                                        displaySize="Custom"
                                        customDisplaySize="3.5rem"
                                        customFontSize="1.25rem"
                                        class="orderDetailItemImage" />
                                    <ObjectIdentifier title="{orders>foodName}" text="{orders>foodId}" />
                                    <Text text="{= ${orders>unitPriceText} + ' ' + ${orders>currency} }" class="orderItemAmount" />
                                    <Text text="{orders>quantity}" textAlign="Center" />
                                    <Text text="{= ${orders>lineAmountText} + ' ' + ${orders>currency} }" class="orderItemAmount" />
                                    <ObjectStatus text="{orders>itemStatus}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    text="Checkout"
                    type="Emphasized"
                    icon="sap-icon://cart"
                    visible="{orders>/selectedOrder/canCheckout}"
                    press=".onCheckout" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
