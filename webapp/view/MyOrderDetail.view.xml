<mvc:View
    controllerName="sap490g7fioriapp.controller.MyOrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <Page title="Order Detail" showNavButton="true" navButtonPress=".onBack">
        <content>
            <VBox class="sapUiMediumMargin">
                <ObjectHeader
                    title="{= 'Order ' + ${orders>/selectedOrder/orderId} }"
                    number="{orders>/selectedOrder/totalAmountText}"
                    numberUnit="{orders>/selectedOrder/currency}"
                    intro="{= 'Ngày ' + ${orders>/selectedOrder/orderDateDisplay} + ' ' + ${orders>/selectedOrder/orderTime} }"
                    backgroundDesign="Solid">
                    <attributes>
                        <ObjectAttribute title="Trạng thái đơn" text="{orders>/selectedOrder/orderStatus}" />
                        <ObjectAttribute title="Trạng thái thanh toán" text="{orders>/selectedOrder/paymentStatus}" />
                    </attributes>
                </ObjectHeader>
                <Button
                    text="Checkout"
                    type="Emphasized"
                    icon="sap-icon://cart"
                    visible="{= ${orders>/selectedOrder/orderStatus} === 'CREATED' }"
                    press=".onCheckout"
                    class="sapUiSmallMarginTop" />

                <Panel headerText="Thông tin đơn hàng" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Mã đơn hàng" />
                            <Text text="{orders>/selectedOrder/orderId}" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Ghi chú" />
                            <Text text="{orders>/selectedOrder/note}" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="Sản phẩm trong đơn" class="sapUiSmallMarginTop">
                    <Table items="{orders>/selectedOrder/items}" class="orderItemsTable">
                        <columns>
                            <Column width="38%"><Text text="Product" /></Column>
                            <Column hAlign="End" width="18%"><Text text="Unit price" /></Column>
                            <Column hAlign="Center" width="12%"><Text text="Quantity" /></Column>
                            <Column hAlign="End" width="20%"><Text text="Line amount" /></Column>
                            <Column width="12%"><Text text="Status" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <ObjectIdentifier title="{orders>foodName}" text="{orders>foodId}" />
                                    <Text text="{= ${orders>unitPriceText} + ' ' + ${orders>currency} }" class="orderItemAmount" />
                                    <Text text="{orders>quantity}" textAlign="Center" />
                                    <Text text="{= ${orders>lineAmountText} + ' ' + ${orders>currency} }" class="orderItemAmount" />
                                    <ObjectStatus text="{orders>itemStatus}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
