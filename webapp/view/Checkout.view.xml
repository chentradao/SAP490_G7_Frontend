<mvc:View controllerName="sap490g7fioriapp.controller.Checkout" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true">
    <Page title="Checkout">
        <headerContent><Button icon="sap-icon://nav-back" text="Back" press=".onBack" /></headerContent>
        <content>
            <HBox width="100%" class="sapUiMediumMargin" renderType="Div">
                <VBox width="65%" class="sapUiMediumMarginEnd">
                    <Title text="Chi tiết đơn hàng mới nhất" level="H3" class="sapUiSmallMarginBottom" />
                    <Text text="Order: {checkoutData>/orderId}" class="sapUiTinyMarginBottom" />
                    <Table items="{checkoutData>/items}" class="checkoutItemsTable">
                        <columns>
                            <Column width="40%"><Text text="Product" /></Column>
                            <Column hAlign="End" width="18%"><Text text="Unit price" /></Column>
                            <Column hAlign="Center" width="12%"><Text text="Quantity" /></Column>
                            <Column hAlign="End" width="22%"><Text text="Line amount" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <ObjectIdentifier title="{checkoutData>foodName}" text="{checkoutData>foodId}" />
                                    <Text text="{= ${checkoutData>unitPriceText} + ' ' + ${checkoutData>currency} }" class="orderItemAmount" />
                                    <Text text="{checkoutData>quantity}" textAlign="Center" />
                                    <Text text="{= ${checkoutData>lineAmountText} + ' ' + ${checkoutData>currency} }" class="orderItemAmount" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                        <Text text="Tổng thanh toán" class="sapMTitleStyle" />
                        <Title text="{= ${checkoutData>/totalAmountText} + ' ' + ${checkoutData>/currency} }" level="H3" />
                    </HBox>
                </VBox>
                <VBox width="35%" alignItems="Center" class="sapUiSmallPaddingTop">
                    <Panel headerText="Mã QR PayOS" width="100%">
                        <VBox alignItems="Center" class="sapUiMediumMargin">
                            <BusyIndicator visible="{qrModel>/loading}" class="sapUiMediumMarginBottom" />
                            <Image src="{qrModel>/qrCodeUrl}" width="220px" height="220px" visible="{qrModel>/hasQr}" error=".onQrImageError" class="sapUiMediumMarginBottom" />
                            <Text text="{qrModel>/statusText}" textAlign="Center" class="sapUiTinyMarginBottom" />
                            <Text text="Mã giao dịch: {qrModel>/transactionRef}" visible="{qrModel>/hasQr}" />
                            <Button text="Mở trang thanh toán PayOS" visible="{= !!${qrModel>/checkoutUrl} }" type="Transparent" press=".onOpenCheckoutUrl" class="sapUiTinyMarginTop" />
                            <Button text="Tạo lại mã QR" icon="sap-icon://refresh" enabled="{= !${qrModel>/loading} &amp;&amp; !!${checkoutData>/orderId} }" type="Emphasized" press=".onRegenerateQr" class="sapUiTinyMarginTop" />
                        </VBox>
                    </Panel>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
