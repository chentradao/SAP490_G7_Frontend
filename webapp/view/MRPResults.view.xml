<mvc:View
  controllerName="sap490g7fioriapp.controller.MRPResults"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="MRP Results" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>

    <content>
      <VBox class="poHistoryShell">
        <HBox class="poHistoryHero" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox class="poHistoryHeroText">
            <Title text="Material Requirements Planning Results" level="H2" />
            <Text text="Review planned production receipts and raw-material purchase requisitions generated by MRP." class="poHistorySubtitle" />
          </VBox>
          <ObjectStatus text="Plant P001" icon="sap-icon://factory" state="Information" inverted="true" />
        </HBox>

        <Panel headerText="Filters" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Label text="Material" labelFor="mrpMaterialFilter" />
              <SearchField
                id="mrpMaterialFilter"
                width="18rem"
                placeholder="e.g. FG00015 or RW00001"
                search="onFilter"
                liveChange="onFilter" />
              <ToolbarSeparator />
              <Label text="Plant" labelFor="mrpPlantFilter" />
              <Input id="mrpPlantFilter" value="P001" width="8rem" submit="onFilter" />
              <ToolbarSeparator />
              <Label text="Show PRs" labelFor="mrpPRScope" />
              <Select id="mrpPRScope" selectedKey="ALL" width="11rem" change="onFilter">
                <core:Item key="OPEN" text="Open only" />
                <core:Item key="ALL" text="All history" />
              </Select>
              <ToolbarSpacer />
              <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters" />
              <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
            </Toolbar>
          </content>
        </Panel>

        <Panel headerText="1. Planned Orders (Finished Goods)" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Text text="Select one Planned Order to convert it into a Production Order." />
              <ToolbarSpacer />
              <Button
                id="convertPlannedOrderButton"
                text="Convert to Production Order"
                icon="sap-icon://factory"
                type="Emphasized"
                enabled="{= !${mrp>/busy} }"
                press="onConvertPlannedOrder" />
            </Toolbar>
            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true" class="wideTableScroll">
              <Table
                id="plannedOrdersTable"
                class="poHistoryTable wideDataTable"
                mode="SingleSelectMaster"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                growing="true"
                growingThreshold="20"
                noDataText="No MRP planned orders found"
                items="{/MRPPlannedOrders}">
                <columns>
                  <Column width="13rem"><Text text="Planned Order" /></Column>
                  <Column width="11rem"><Text text="Material" /></Column>
                  <Column width="18rem"><Text text="Description" /></Column>
                  <Column width="8rem"><Text text="Plant" /></Column>
                  <Column width="9rem"><Text text="Type" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Planned Quantity" /></Column>
                  <Column width="12rem"><Text text="Start Date" /></Column>
                  <Column width="12rem"><Text text="End Date" /></Column>
                  <Column width="11rem"><Text text="Production Version" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <ObjectIdentifier title="{PlannedOrder}" />
                      <ObjectIdentifier title="{Material}" />
                      <Text text="{MaterialDescription}" />
                      <Text text="{Plant}" />
                      <Text text="{PlannedOrderType}" />
                      <ObjectNumber number="{PlannedOrderQuantity}" unit="{Unit}" />
                      <Text text="{path: 'PlannedStartDate', formatter: '.formatDate'}" />
                      <Text text="{path: 'PlannedEndDate', formatter: '.formatDate'}" />
                      <Text text="{ProductionVersion}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>

        <Panel headerText="2. Purchase Requisitions (Raw Materials)" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Text text="Select one open PR item to create a referenced Purchase Order." />
              <ToolbarSpacer />
              <Button
                text="Convert to Purchase Order"
                icon="sap-icon://cart"
                type="Emphasized"
                enabled="{= !${mrp>/busy} }"
                press="onConvertPurchaseRequisition" />
            </Toolbar>
            <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true" class="wideTableScroll">
              <Table
                id="purchaseRequisitionsTable"
                class="poHistoryTable wideDataTable"
                mode="SingleSelectMaster"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                growing="true"
                growingThreshold="20"
                noDataText="No MRP purchase requisitions found"
                items="{/MRPPurchaseRequisitions}">
                <columns>
                  <Column width="13rem"><Text text="Purchase Requisition" /></Column>
                  <Column width="8rem"><Text text="Item" /></Column>
                  <Column width="11rem"><Text text="Material" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Requested Quantity" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Ordered Quantity" /></Column>
                  <Column width="11rem" hAlign="End"><Text text="Open Quantity" /></Column>
                  <Column width="9rem"><Text text="Closed" /></Column>
                  <Column width="18rem"><Text text="Description" /></Column>
                  <Column width="8rem"><Text text="Plant" /></Column>
                  <Column width="10rem"><Text text="Storage" /></Column>
                  <Column width="12rem"><Text text="Delivery Date" /></Column>
                  <Column width="11rem"><Text text="MRP Controller" /></Column>
                  <Column width="12rem"><Text text="Processing Status" /></Column>
                  <Column width="13rem"><Text text="Purchase Order" /></Column>
                </columns>
                <items>
                  <ColumnListItem highlight="{path: 'ProcessingStatus', formatter: '.formatPRHighlight'}">
                    <cells>
                      <ObjectIdentifier title="{PurchaseRequisition}" />
                      <Text text="{PurchaseRequisitionItem}" />
                      <ObjectIdentifier title="{Material}" />
                      <ObjectNumber number="{RequestedQuantity}" unit="{Unit}" />
                      <ObjectNumber number="{OrderedQuantity}" unit="{Unit}" />
                      <ObjectNumber
                        number="{OpenQuantity}"
                        unit="{Unit}"
                        state="{path: 'OpenQuantity', formatter: '.formatOpenQuantityState'}" />
                      <ObjectStatus
                        text="{path: 'IsClosed', formatter: '.formatClosedText'}"
                        state="{path: 'IsClosed', formatter: '.formatClosedState'}" />
                      <Text text="{MaterialDescription}" />
                      <Text text="{Plant}" />
                      <Text text="{StorageLocation}" />
                      <Text text="{path: 'DeliveryDate', formatter: '.formatDate'}" />
                      <Text text="{MRPController}" />
                      <ObjectStatus
                        text="{path: 'ProcessingStatus', formatter: '.formatPRStatus'}"
                        state="{path: 'ProcessingStatus', formatter: '.formatPRState'}" />
                      <ObjectIdentifier title="{PurchaseOrder}" text="{PurchaseOrderItem}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
