<!-- View MRPResults.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
  controllerName="sap490g7fioriapp.controller.MRPResults"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <!-- Trang chính: MRP Results -->
  <Page title="MRP Results" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>

    <content>
      <VBox class="poHistoryShell">
        <HBox class="poHistoryHero" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox class="poHistoryHeroText">
            <Title text="Material Requirements Planning Results" level="H2" />
            <Text text="Review planned production receipts and raw-material purchase requisitions generated by MRP." class="poHistorySubtitle" />
          </VBox>
          <ObjectStatus text="Plant P001" icon="sap-icon://factory" state="Information" inverted="true" />
        </HBox>

        <MessageStrip
          text="Process the earliest Required Date first. Note: the current SAP entity does not expose which PIR or finished good created each PR."
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <!-- Khu vực nghiệp vụ: Filters -->
        <Panel headerText="Filters" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Label text="Material" labelFor="mrpMaterialFilter" />
              <SearchField
                id="mrpMaterialFilter"
                width="18rem"
                placeholder="e.g. FG00015 or RW00001"
                search="onFilter"
                liveChange="onFilter" />
              <ToolbarSeparator />
              <Label text="Purchase Requisition" labelFor="mrpPRFilter" />
              <SearchField
                id="mrpPRFilter"
                width="14rem"
                placeholder="Enter PR number"
                search="onFilter"
                liveChange="onFilter" />
              <ToolbarSeparator />
              <Label text="Plant" labelFor="mrpPlantFilter" />
              <Input id="mrpPlantFilter" value="P001" width="8rem" submit="onFilter" />
              <ToolbarSeparator />
              <Label text="Show PRs" labelFor="mrpPRScope" />
              <Select id="mrpPRScope" selectedKey="OPEN" width="11rem" change="onFilter">
                <core:Item key="OPEN" text="Open only" />
                <core:Item key="ALL" text="All history" />
              </Select>
              <ToolbarSeparator />
              <Label text="Sort" labelFor="mrpPRSort" />
              <Select id="mrpPRSort" selectedKey="PRIORITY" width="12rem" change="onFilter">
                <core:Item key="PRIORITY" text="Required first" />
                <core:Item key="NEWEST" text="Newest created" />
                <core:Item key="OLDEST" text="Oldest created" />
              </Select>
              <ToolbarSpacer />
              <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters" />
              <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
            </Toolbar>
          </content>
        </Panel>

        <IconTabBar class="staffWorkflowPanel mrpActionTabs" expandable="false" selectedKey="PURCHASE">
          <items>
          <!-- Tab chức năng: 1. Buy Missing Materials -->
          <IconTabFilter key="PURCHASE" text="1. Buy Missing Materials" icon="sap-icon://cart">
        <!-- Khu vực nghiệp vụ: Purchase Requisitions — Raw Materials to Buy -->
        <Panel headerText="Purchase Requisitions — Raw Materials to Buy" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Text text="Select an open request, create its Purchase Order, then receive it into RM01." />
              <ToolbarSpacer />
              <Button
                text="Create Purchase Order"
                icon="sap-icon://cart"
                type="Emphasized"
                enabled="{= !${mrp>/busy} }"
                press="onConvertPurchaseRequisition" />
            </Toolbar>
            <ScrollContainer width="100%" height="55vh" horizontal="true" vertical="true" focusable="true" class="wideTableScroll">
              <Table
                id="purchaseRequisitionsTable"
                class="poHistoryTable wideDataTable"
                mode="SingleSelectMaster"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                growing="true"
                growingThreshold="20"
                noDataText="No raw materials need purchasing"
                items="{path: 'prResults>/items', sorter: [{path: 'DeliveryDate', descending: false}, {path: 'CreationDate', descending: false}, {path: 'PurchaseRequisition', descending: false}]}">
                <columns>
                  <Column width="9rem"><Text text="Priority" /></Column>
                  <Column width="11rem"><Text text="Purchase Requisition" /></Column>
                  <Column width="9rem"><Text text="Material" /></Column>
                  <Column width="14rem"><Text text="Description" /></Column>
                  <Column width="10rem" hAlign="End"><Text text="Need to Buy" /></Column>
                  <Column width="10rem"><Text text="Required Date" /></Column>
                  <Column width="12rem"><Text text="Status" /></Column>
                  <Column width="11rem"><Text text="Purchase Order" /></Column>
                </columns>
                <items>
                  <ColumnListItem highlight="{path: 'prResults>ProcessingStatus', formatter: '.formatPRHighlight'}">
                    <cells>
                      <ObjectStatus
                        text="{path: 'prResults>DeliveryDate', formatter: '.formatPriorityText'}"
                        state="{path: 'prResults>DeliveryDate', formatter: '.formatPriorityState'}"
                        icon="{path: 'prResults>DeliveryDate', formatter: '.formatPriorityIcon'}" />
                      <ObjectIdentifier title="{prResults>PurchaseRequisition}" text="Item {prResults>PurchaseRequisitionItem}" />
                      <ObjectIdentifier title="{prResults>Material}" />
                      <Text text="{prResults>MaterialDescription}" />
                      <ObjectNumber number="{prResults>OpenQuantity}" unit="{prResults>Unit}" state="{path: 'prResults>OpenQuantity', formatter: '.formatOpenQuantityState'}" />
                      <Text text="{path: 'prResults>DeliveryDate', formatter: '.formatDate'}" />
                      <ObjectStatus text="{parts: ['prResults>ProcessingStatus', 'prResults>OpenQuantity', 'prResults>IsClosed', 'prResults>PurchaseOrder'], formatter: '.formatPRStatus'}" state="{parts: ['prResults>ProcessingStatus', 'prResults>OpenQuantity', 'prResults>IsClosed', 'prResults>PurchaseOrder'], formatter: '.formatPRState'}" />
                      <ObjectIdentifier title="{prResults>PurchaseOrder}" text="{prResults>PurchaseOrderItem}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>
          </IconTabFilter>

          <!-- Tab chức năng: 2. Create Production Order -->
          <IconTabFilter key="PRODUCTION" text="2. Create Production Order" icon="sap-icon://factory">
        <!-- Khu vực nghiệp vụ: Planned Orders — Ready for Production -->
        <Panel headerText="Planned Orders — Ready for Production" class="staffWorkflowPanel">
          <content>
            <Toolbar>
              <Text text="Select a proposal. The system checks BOM stock before conversion." />
              <ToolbarSpacer />
              <Button
                id="convertPlannedOrderButton"
                text="Create Production Order"
                icon="sap-icon://factory"
                type="Emphasized"
                enabled="{= !${mrp>/busy} }"
                press="onConvertPlannedOrder" />
            </Toolbar>
            <ScrollContainer width="100%" height="55vh" horizontal="true" vertical="true" focusable="true" class="wideTableScroll">
              <Table
                id="plannedOrdersTable"
                class="poHistoryTable wideDataTable"
                mode="SingleSelectMaster"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                growing="true"
                growingThreshold="20"
                noDataText="No planned production orders found"
                items="{path: '/MRPPlannedOrders', sorter: {path: 'PlannedOrder', descending: true}}">
                <columns>
                  <Column width="13rem"><Text text="Planned Order" /></Column>
                  <Column width="11rem"><Text text="Material" /></Column>
                  <Column width="18rem"><Text text="Description" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Quantity" /></Column>
                  <Column width="12rem"><Text text="Production Date" /></Column>
                  <Column width="8rem"><Text text="Plant" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <ObjectIdentifier title="{PlannedOrder}" />
                      <ObjectIdentifier title="{Material}" />
                      <Text text="{MaterialDescription}" />
                      <ObjectNumber number="{PlannedOrderQuantity}" unit="{Unit}" />
                      <Text text="{path: 'PlannedStartDate', formatter: '.formatDate'}" />
                      <Text text="{Plant}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>
          </IconTabFilter>
          </items>
        </IconTabBar>
      </VBox>
    </content>
  </Page>
</mvc:View>
