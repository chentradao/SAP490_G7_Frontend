<mvc:View
  controllerName="sap490g7fioriapp.controller.ProductionOrder"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  displayBlock="true">

  <Page title="Production Planning" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button
        id="syncFoodStockButton"
        text="Sync FG Stock"
        tooltip="Overwrite Food2 stock with the current stock from P001/FG01"
        icon="sap-icon://synchronize"
        type="Transparent"
        visible="{= ${session>/role} === 'ADMIN' }"
        press="onSyncFoodStock" />
      <Button text="Work Queue" icon="sap-icon://workflow-tasks" type="Emphasized" press="onOpenHistory" />
    </headerContent>

    <content>
      <VBox class="productionOrderShell">
        <HBox class="productionOrderHero" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox>
            <Title text="Create Production Order" level="H2" />
            <Text text="Select a finished product, verify component availability, then create the order in SAP." class="poHistorySubtitle" />
          </VBox>
          <VBox alignItems="End">
            <ObjectStatus text="P001 / FG01" icon="sap-icon://factory" state="Information" inverted="true" />
            <ObjectStatus
              text="{ui>/lastStockSyncText}"
              icon="sap-icon://synchronize"
              state="Information"
              visible="{= ${session>/role} === 'ADMIN' }"
              class="sapUiTinyMarginTop" />
          </VBox>
        </HBox>

        <Panel headerText="1. Select Finished Product" class="productionStepCard">
          <content>
            <Text text="Choose one product currently maintained in plant P001 and storage FG01." class="productionStepHint" />
            <ScrollContainer width="100%" height="15rem" horizontal="true" vertical="true" focusable="true" class="wideTableScroll sapUiSmallMarginTop">
              <Table
                id="fgTable"
                class="wideDataTableMD compactSelectionTable"
                items="{path: '/Food2', filters: [{path: 'MaterialNumber', operator: 'GE', value1: 'FG00009'}]}"
                mode="SingleSelectMaster"
                selectionChange="onFGSelected"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                growing="true"
                growingThreshold="15"
                noDataText="No finished products found in P001 / FG01">
                <columns>
                  <Column width="11rem"><Text text="Material" /></Column>
                  <Column width="20rem"><Text text="Description" /></Column>
                  <Column width="9rem"><Text text="Location" /></Column>
                  <Column width="11rem" hAlign="End"><Text text="Available Stock" /></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active" vAlign="Middle">
                    <cells>
                      <ObjectIdentifier title="{MaterialNumber}" />
                      <Text text="{MaterialDescription}" />
                      <ObjectStatus text="{= ${Plant} + ' / ' + ${StorageLocation} }" state="Information" />
                      <ObjectNumber number="{AvailableStock}" unit="{BaseUnit}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>

        <Panel headerText="2. Review BOM and Material Availability" class="productionStepCard">
          <content>
            <MessageStrip
              text="Select a finished product above to load its BOM and current raw-material availability."
              type="Information"
              showIcon="true"
              visible="{= !${ui>/selectedMaterial} }" />

            <HBox
              class="productionSelectionSummary"
              justifyContent="SpaceBetween"
              alignItems="Center"
              wrap="Wrap"
              visible="{= !!${ui>/selectedMaterial} }">
              <VBox>
                <Label text="Selected Product" />
                <Title text="{ui>/selectedMaterial}" level="H3" />
                <Text text="{ui>/selectedDescription}" />
              </VBox>
              <VBox alignItems="End">
                <Label text="Current FG Stock" />
                <ObjectNumber number="{ui>/selectedStock}" unit="{ui>/selectedUnit}" emphasized="true" state="Success" />
              </VBox>
            </HBox>

            <MessageStrip
              text="{ui>/shortageMessage}"
              type="Error"
              showIcon="true"
              visible="{ui>/hasShortage}"
              class="sapUiSmallMarginTop" />

            <ScrollContainer width="100%" height="16rem" horizontal="true" vertical="true" focusable="true" class="wideTableScroll sapUiSmallMarginTop">
              <Table
                id="bomTable"
                class="wideDataTableMD"
                items="{ui>/bom}"
                sticky="ColumnHeaders"
                alternateRowColors="true"
                noDataText="Select a finished product to view its BOM.">
                <columns>
                  <Column width="11rem"><Text text="Component" /></Column>
                  <Column width="20rem"><Text text="Description" /></Column>
                  <Column width="11rem" hAlign="End"><Text text="Required / Unit" /></Column>
                  <Column width="13rem" hAlign="End"><Text text="Required for Order" /></Column>
                  <Column width="12rem" hAlign="End"><Text text="Available Stock" /></Column>
                  <Column width="10rem"><Text text="Status" /></Column>
                </columns>
                <items>
                  <ColumnListItem vAlign="Middle" highlight="{ui>AvailabilityState}">
                    <cells>
                      <ObjectIdentifier title="{ui>ComponentMaterial}" />
                      <Text text="{ui>ComponentDescription}" />
                      <ObjectNumber number="{ui>ComponentQuantity}" unit="{ui>ComponentUnit}" />
                      <ObjectNumber number="{ui>RequiredForOrder}" unit="{ui>ComponentUnit}" state="{ui>AvailabilityState}" />
                      <ObjectNumber number="{ui>AvailableQuantity}" unit="{ui>ComponentUnit}" state="{ui>AvailabilityState}" />
                      <ObjectStatus text="{ui>AvailabilityText}" state="{ui>AvailabilityState}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </ScrollContainer>
          </content>
        </Panel>

        <Panel headerText="3. Enter Order Quantity" class="productionStepCard">
          <content>
            <HBox class="productionOrderEntry" justifyContent="SpaceBetween" alignItems="End" wrap="Wrap">
              <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                columnsXL="2"
                columnsL="2"
                columnsM="1">
                <Label text="Order Quantity" required="true" />
                <Input value="{ui>/orderQuantity}" type="Number" description="{ui>/selectedUnit}"
                  liveChange="onOrderQuantityChange" change="onOrderQuantityChange"
                  valueState="{= ${ui>/hasShortage} ? 'Error' : 'None' }"
                  valueStateText="{ui>/shortageMessage}"
                  enabled="{= !!${ui>/selectedMaterial} }" />
                <Label text="Order Type" />
                <Input value="{ui>/orderType}" editable="false" />
                <Label text="Production Version" />
                <Input value="{ui>/productionVersion}" editable="false" />
              </f:SimpleForm>
              <Button
                text="Create Production Order"
                icon="sap-icon://add-process"
                type="Emphasized"
                press="onCreateProductionOrder"
                enabled="{ui>/canCreate}"
                class="productionCreateButton" />
            </HBox>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
