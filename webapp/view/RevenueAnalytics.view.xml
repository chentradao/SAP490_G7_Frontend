<!-- View RevenueAnalytics.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
  controllerName="sap490g7fioriapp.controller.RevenueAnalytics"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <!-- Trang chính: Revenue Analytics -->
  <Page title="Revenue Analytics" showNavButton="true" navButtonPress="onBack" busy="{analytics>/busy}">
    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>
    <content>
      <VBox class="revenueAnalyticsShell">
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="poHistoryHero">
          <VBox>
            <Title text="Sales and Purchase Performance" level="H2" />
            <Text text="Revenue, purchase receipts and operating balance by business date." class="poHistorySubtitle" />
          </VBox>
          <HBox alignItems="Center">
            <Label text="Period" labelFor="financeRange" class="sapUiTinyMarginEnd" />
            <Select id="financeRange" selectedKey="{analytics>/rangeDays}" change="onRangeChange" width="10rem">
              <core:Item key="7" text="Last 7 days" />
              <core:Item key="30" text="Last 30 days" />
              <core:Item key="ALL" text="All history" />
            </Select>
          </HBox>
        </HBox>

        <MessageStrip text="{analytics>/message}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />

        <FlexBox wrap="Wrap" class="staffSalesKpiRow">
          <VBox class="staffSalesKpi staffSalesKpiRevenue">
            <Text text="Paid revenue" />
            <Title text="{= ${analytics>/revenueText} + ' ' + ${analytics>/currency} }" level="H2" />
            <Text text="{= ${analytics>/successfulOrders} + ' successful orders' }" />
          </VBox>
          <VBox class="staffSalesKpi staffSalesKpiCancelled">
            <Text text="Purchase receipts cost" />
            <Title text="{= ${analytics>/purchaseCostText} + ' ' + ${analytics>/currency} }" level="H2" />
            <Text text="Based on posted goods receipts" />
          </VBox>
          <VBox class="staffSalesKpi staffSalesKpiConfirmed">
            <Text text="Operating balance" />
            <Title text="{= ${analytics>/balanceText} + ' ' + ${analytics>/currency} }" level="H2" />
            <Text text="Revenue minus purchase receipts" />
          </VBox>
          <VBox class="staffSalesKpi staffSalesKpiItems">
            <Text text="Cancelled orders" />
            <Title text="{analytics>/cancelledOrders}" level="H2" />
            <Text text="{= ${analytics>/cancelledAmountText} + ' ' + ${analytics>/currency} }" />
          </VBox>
        </FlexBox>

        <HBox wrap="Wrap" class="revenueChartLegend sapUiSmallMarginTop sapUiSmallMarginBottom">
          <ObjectStatus text="Revenue" state="Information" icon="sap-icon://circle-task-2" />
          <ObjectStatus text="Purchase Cost" state="Warning" icon="sap-icon://circle-task-2" class="sapUiSmallMarginBegin" />
          <ObjectStatus text="Operating Balance" state="Success" icon="sap-icon://circle-task-2" class="sapUiSmallMarginBegin" />
        </HBox>

        <!-- Khu vực nghiệp vụ: Daily Trend -->
        <Panel headerText="Daily Trend" class="staffWorkflowPanel">
          <core:HTML content="{analytics>/chartHtml}" sanitizeContent="false" />
        </Panel>

        <!-- Khu vực nghiệp vụ: Daily Finance Details -->
        <Panel headerText="Daily Finance Details" class="staffWorkflowPanel sapUiSmallMarginTop">
          <ScrollContainer width="100%" height="38vh" horizontal="true" vertical="true" focusable="true" class="wideTableScroll">
            <Table
              class="poHistoryTable wideDataTable"
              sticky="ColumnHeaders"
              alternateRowColors="true"
              growing="true"
              growingThreshold="30"
              noDataText="No finance data for this period"
              items="{analytics>/rows}">
              <columns>
                <Column width="11rem"><Text text="Business Date" /></Column>
                <Column width="11rem" hAlign="End"><Text text="Successful Orders" /></Column>
                <Column width="14rem" hAlign="End"><Text text="Revenue" /></Column>
                <Column width="14rem" hAlign="End"><Text text="Purchase Cost" /></Column>
                <Column width="14rem" hAlign="End"><Text text="Operating Balance" /></Column>
                <Column width="11rem" hAlign="End"><Text text="Cancelled Orders" /></Column>
                <Column width="14rem" hAlign="End"><Text text="Cancelled Amount" /></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{path: 'analytics>date', formatter: '.formatDate'}" />
                    <ObjectNumber number="{analytics>successfulOrders}" />
                    <ObjectNumber number="{path: 'analytics>revenue', formatter: '.formatAmount'}" unit="{analytics>currency}" state="Information" />
                    <ObjectNumber number="{path: 'analytics>purchaseCost', formatter: '.formatAmount'}" unit="{analytics>currency}" state="Warning" />
                    <ObjectNumber number="{path: 'analytics>balance', formatter: '.formatAmount'}" unit="{analytics>currency}" state="{path: 'analytics>balance', formatter: '.formatBalanceState'}" />
                    <ObjectNumber number="{analytics>cancelledOrders}" state="Error" />
                    <ObjectNumber number="{path: 'analytics>cancelledAmount', formatter: '.formatAmount'}" unit="{analytics>currency}" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </ScrollContainer>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
