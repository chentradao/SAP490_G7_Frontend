<mvc:View
    controllerName="sap490g7fioriapp.controller.CashierOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page
        title="Order Management"
        showNavButton="true"
        navButtonPress=".onBack"
        busy="{orders>/busy}"
        busyIndicatorDelay="0"
        class="sapUiContentPadding">

        <headerContent>
            <Button
                icon="sap-icon://refresh"
                tooltip="Refresh list"
                type="Transparent"
                press=".onRefresh" />
            <Button
                icon="sap-icon://log"
                text="Logout"
                type="Transparent"
                press=".onLogout" />
        </headerContent>

        <subHeader>
            <OverflowToolbar>
                <SearchField
                    id="searchField"
                    placeholder="Search by order ID or customer..."
                    liveChange=".onSearch"
                    width="320px" />
            </OverflowToolbar>
        </subHeader>

        <content>
            <Table
                id="cashierOrderTable"
                items="{orders>/filteredOrders}"
                noDataText="No paid orders match your filters"
                growing="true"
                growingThreshold="25"
                sticky="HeaderToolbar,ColumnHeaders"
                alternateRowColors="true">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Paid Orders" level="H3" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="quickStatusBar"
                            selectionChange=".onQuickStatusChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All" />
                                <SegmentedButtonItem key="PENDING" text="Pending" />
                                <SegmentedButtonItem key="CONFIRMED" text="Confirmed" />
                                <SegmentedButtonItem key="CANCELLED" text="Cancelled" />
                            </items>
                        </SegmentedButton>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column width="14rem">
                        <Text text="Order ID" />
                    </Column>
                    <Column width="13rem">
                        <Text text="Customer" />
                    </Column>
                    <Column width="14rem">
                        <Text text="Updated At" />
                    </Column>
                    <Column width="11rem" hAlign="End">
                        <Text text="Total Amount" />
                    </Column>
                    <Column width="10rem" hAlign="Center">
                        <Text text="Order Status" />
                    </Column>
                    <Column width="10rem" hAlign="Center">
                        <Text text="Payment" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onOrderPress">
                        <cells>
                            <ObjectIdentifier title="{orders>orderId}" />
                            <Text text="{= ${orders>customerName} || ${orders>userId} || 'N/A' }" />
                            <Text text="{ path: 'orders>updatedAt', formatter: '.formatUpdatedAt' }" />
                            <ObjectNumber
                                number="{ path: 'orders>totalAmount', formatter: '.formatAmount' }"
                                unit="{= ${orders>currency} || 'VND' }"
                                state="{= ${orders>orderStatus} === 'CONFIRMED' ? 'Success'
                                         : ${orders>orderStatus} === 'CANCELLED' ? 'Error'
                                         : 'Warning' }" />
                            <ObjectStatus
                                text="{= ${orders>orderStatus} === 'PENDING' ? 'Pending'
                                        : ${orders>orderStatus} === 'CONFIRMED' ? 'Confirmed'
                                        : ${orders>orderStatus} === 'CANCELLED' ? 'Cancelled'
                                        : ${orders>orderStatus} }"
                                icon="{= ${orders>orderStatus} === 'PENDING' ? 'sap-icon://time-overtime'
                                        : ${orders>orderStatus} === 'CONFIRMED' ? 'sap-icon://accept'
                                        : ${orders>orderStatus} === 'CANCELLED' ? 'sap-icon://sys-cancel-2'
                                        : 'sap-icon://status-inactive' }"
                                state="{= ${orders>orderStatus} === 'PENDING' ? 'Warning'
                                        : ${orders>orderStatus} === 'CONFIRMED' ? 'Success'
                                        : ${orders>orderStatus} === 'CANCELLED' ? 'Error'
                                        : 'None' }" />
                            <ObjectStatus
                                text="Paid"
                                state="Success" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
