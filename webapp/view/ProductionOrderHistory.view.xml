<mvc:View
  controllerName="sap490g7fioriapp.controller.ProductionOrderHistory"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page
    title="Production Order History"
    showNavButton="true"
    navButtonPress="onNavBack">

    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>

    <content>
      <VBox class="poHistoryShell">
        <VBox class="poHistoryIntro">
          <Title text="Production Order History" level="H2" />
          <Text text="Track production-order requests, SAP results and release status." class="poHistorySubtitle" />
        </VBox>

        <OverflowToolbar class="poHistoryFilterBar">
          <SearchField
            id="productionHistorySearch"
            width="22rem"
            placeholder="Search order, material or request ID"
            search="onSearch" />
          <Select
            id="productionStatusFilter"
            width="12rem"
            selectedKey="ALL"
            change="onStatusChange">
            <core:Item key="ACTIVE" text="Needs Action" />
            <core:Item key="ALL" text="All Statuses" />
            <core:Item key="CREATED" text="Created" />
            <core:Item key="RELEASED" text="Released" />
            <core:Item key="GOODS_ISSUED" text="Goods Issued" />
            <core:Item key="GOODS_RECEIVED" text="Goods Received" />
            <core:Item key="COMPLETED" text="Completed" />
            <core:Item key="ERROR" text="Error" />
            <core:Item key="PENDING" text="Pending" />
          </Select>
          <ToolbarSpacer />
          <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters" />
          <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
        </OverflowToolbar>

        <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true" class="wideTableScroll">
        <Table
          id="productionHistoryTable"
          class="poHistoryTable wideDataTable wideDataTableXXL"
          sticky="ColumnHeaders"
          alternateRowColors="true"
          growing="true"
          growingScrollToLoad="true"
          growingThreshold="20"
          noDataText="No production-order requests found"
          items="{/ProductionOrderRequests}">
          <columns>
            <Column width="14rem"><Text text="Production Order" /></Column>
            <Column width="12rem"><Text text="Source" /></Column>
            <Column width="11rem"><Text text="Material" /></Column>
            <Column width="7rem"><Text text="Plant" /></Column>
            <Column width="10rem" hAlign="End"><Text text="Quantity" /></Column>
            <Column width="8rem"><Text text="Order Type" /></Column>
            <Column width="10rem"><Text text="Status" /></Column>
            <Column width="15rem"><Text text="Next Step" /></Column>
            <Column width="14rem"><Text text="Goods Issue" /></Column>
            <Column width="14rem"><Text text="Production GR" /></Column>
            <Column width="12rem"><Text text="Created At" /></Column>
            <Column minScreenWidth="Desktop" demandPopin="true" width="20rem"><Text text="BAPI Message" /></Column>
          </columns>
          <items>
            <ColumnListItem
              vAlign="Middle"
              highlight="{path: 'status', formatter: '.formatHighlight'}">
              <cells>
                <VBox>
                  <ObjectIdentifier title="{= ${production_order} || 'Not created' }" text="{request_id}" />
                  <Button
                    text="Release"
                    icon="sap-icon://play"
                    type="Emphasized"
                    class="sapUiTinyMarginTop"
                    press="onRelease"
                    enabled="{parts: [{path: 'production_order'}, {path: 'status'}], formatter: '.canRelease'}" />
                  <Button
                    text="Post Goods Issue"
                    icon="sap-icon://outbox"
                    type="Accept"
                    class="sapUiTinyMarginTop"
                    press="onPostGoodsIssue"
                    enabled="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'material_document'}], formatter: '.canPostGoodsIssue'}" />
                  <Button
                    text="Confirm Operation"
                    icon="sap-icon://complete"
                    type="Emphasized"
                    class="sapUiTinyMarginTop"
                    press="onConfirmOperation"
                    enabled="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'confirmationState>/version'}], formatter: '.canConfirmOperation'}" />
                  <Button
                    text="Post Goods Receipt"
                    icon="sap-icon://inbox"
                    type="Accept"
                    class="sapUiTinyMarginTop"
                    press="onPostProductionGoodsReceipt"
                    enabled="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'gr_material_document'}, {path: 'goods_receipt_status'}, {path: 'confirmationState>/version'}], formatter: '.canPostProductionGoodsReceipt'}" />
                  <Button
                    text="Complete Order"
                    icon="sap-icon://complete"
                    type="Accept"
                    class="sapUiTinyMarginTop"
                    press="onCompleteProductionOrder"
                    enabled="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'gr_material_document'}, {path: 'goods_receipt_status'}], formatter: '.canCompleteProductionOrder'}" />
                </VBox>
                <VBox>
                  <ObjectStatus text="{path: 'planned_order', formatter: '.formatProductionSource'}" state="Information" />
                  <ObjectIdentifier title="{planned_order}" text="Planned Order" visible="{= !!${planned_order} }" />
                </VBox>
                <Text text="{material}" />
                <Text text="{plant}" />
                <ObjectNumber number="{order_quantity}" unit="{unit}" />
                <Text text="{order_type}" />
                <ObjectStatus text="{status}" state="{path: 'status', formatter: '.formatState'}" />
                <ObjectStatus
                  text="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'goods_receipt_status'}, {path: 'confirmationState>/version'}], formatter: '.formatNextStep'}"
                  state="{parts: [{path: 'production_order'}, {path: 'status'}], formatter: '.formatNextStepState'}" />
                <VBox>
                  <ObjectStatus text="{= ${goods_issue_status} || 'Not posted' }" state="{path: 'goods_issue_status', formatter: '.formatGoodsIssueState'}" />
                  <ObjectIdentifier title="{material_document}" text="{material_document_year}" visible="{= !!${material_document} }" />
                  <Text text="{path: 'goods_issued_at', formatter: '.formatDateTime'}" visible="{= !!${goods_issued_at} }" />
                  <Text text="{goods_issue_message}" wrapping="true" maxLines="2" />
                </VBox>
                <VBox>
                  <ObjectStatus text="{= ${goods_receipt_status} || 'Not posted' }" state="{path: 'goods_receipt_status', formatter: '.formatGoodsReceiptState'}" />
                  <ObjectIdentifier title="{gr_material_document}" text="{gr_material_document_year}" visible="{= !!${gr_material_document} }" />
                  <Text text="{path: 'goods_received_at', formatter: '.formatDateTime'}" visible="{= !!${goods_received_at} }" />
                  <Text text="{goods_receipt_message}" wrapping="true" maxLines="2" />
                </VBox>
                <Text text="{path: 'created_at', formatter: '.formatDateTime'}" />
                <Text text="{bapi_message}" wrapping="true" maxLines="2" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        </ScrollContainer>

        <Toolbar class="sapUiMediumMarginTop">
          <Title text="Operation Confirmation History" level="H3" />
          <ToolbarSpacer />
          <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefreshConfirmations" />
        </Toolbar>

        <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="true" class="wideTableScroll">
        <Table
          id="productionConfirmationHistoryTable"
          class="poHistoryTable wideDataTable wideDataTableXL"
          alternateRowColors="true"
          growing="true"
          growingThreshold="15"
          noDataText="No operation confirmations found"
          items="{/ProductionConfirmationHistory}">
          <columns>
            <Column width="11rem"><Text text="Production Order" /></Column>
            <Column width="7rem"><Text text="Operation" /></Column>
            <Column width="11rem"><Text text="Yield" /></Column>
            <Column width="11rem"><Text text="Scrap" /></Column>
            <Column width="9rem"><Text text="Type" /></Column>
            <Column width="11rem"><Text text="Status" /></Column>
            <Column width="13rem"><Text text="Confirmation" /></Column>
            <Column width="14rem"><Text text="Confirmed At" /></Column>
            <Column minScreenWidth="Desktop" demandPopin="true" width="20rem"><Text text="Message" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier title="{production_order}" text="{request_id}" />
                <Text text="{operation}" />
                <ObjectNumber number="{yield_quantity}" unit="{unit}" />
                <ObjectNumber number="{scrap_quantity}" unit="{unit}" />
                <ObjectStatus text="{path: 'final_confirmation', formatter: '.formatConfirmationType'}" />
                <ObjectStatus text="{confirmation_status}" state="{path: 'confirmation_status', formatter: '.formatConfirmationState'}" />
                <ObjectIdentifier title="{confirmation_number}" text="{confirmation_counter}" />
                <Text text="{path: 'confirmed_at', formatter: '.formatDateTime'}" />
                <Text text="{confirmation_message}" wrapping="true" maxLines="2" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        </ScrollContainer>
      </VBox>
    </content>
  </Page>
</mvc:View>
