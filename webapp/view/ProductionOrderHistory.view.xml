<mvc:View
  controllerName="sap490g7fioriapp.controller.ProductionOrderHistory"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page
    title="Production Work Queue"
    showNavButton="true"
    navButtonPress="onNavBack">

    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>

    <content>
      <VBox class="poHistoryShell">
        <VBox class="poHistoryIntro">
          <Title text="Production Work Queue" level="H2" />
          <Text text="Complete the highlighted next action. Open Details only when you need SAP documents or messages." class="poHistorySubtitle" />
        </VBox>

        <OverflowToolbar class="poHistoryFilterBar">
          <SearchField
            id="productionHistorySearch"
            width="22rem"
            placeholder="Search order, material or request ID"
            search="onSearch"
            liveChange="onSearch" />
          <Select
            id="productionStatusFilter"
            width="12rem"
            selectedKey="ACTIVE"
            change="onStatusChange">
            <core:Item key="ACTIVE" text="Needs Action" />
            <core:Item key="ALL" text="All Statuses" />
            <core:Item key="CREATED" text="Created" />
            <core:Item key="RELEASED" text="Released" />
            <core:Item key="GOODS_ISSUED" text="Goods Issued" />
            <core:Item key="GOODS_RECEIVED" text="Goods Received" />
            <core:Item key="COMPLETED" text="Completed" />
            <core:Item key="ERROR" text="Error" />
            <core:Item key="PENDING" text="Pending" />
          </Select>
          <ToolbarSpacer />
          <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters" />
          <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
        </OverflowToolbar>

        <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="false" class="wideTableScroll productionWorkQueueScroll">
        <Table
          id="productionHistoryTable"
          class="poHistoryTable wideDataTable"
          sticky="ColumnHeaders"
          alternateRowColors="true"
          growing="true"
          growingScrollToLoad="true"
          growingThreshold="20"
          noDataText="No production-order requests found"
          items="{path: '/ProductionOrderRequests', filters: [{path: 'material', operator: 'GE', value1: 'FG00009'}], sorter: {path: 'created_at', descending: true}}">
          <columns>
            <Column width="14rem"><Text text="Production Order" /></Column>
            <Column width="16rem"><Text text="Material" /></Column>
            <Column width="10rem" hAlign="End"><Text text="Quantity" /></Column>
            <Column width="11rem"><Text text="Status" /></Column>
            <Column width="29rem"><Text text="Workflow Progress" /></Column>
            <Column width="16rem"><Text text="Next Action" /></Column>
            <Column width="8rem" hAlign="Center"><Text text="Details" /></Column>
          </columns>
          <items>
            <ColumnListItem
              vAlign="Middle"
              highlight="{path: 'status', formatter: '.formatHighlight'}">
              <cells>
                <VBox>
                  <ObjectIdentifier title="{= ${production_order} || 'Not created' }" text="{request_id}" />
                  <ObjectStatus text="{path: 'planned_order', formatter: '.formatProductionSource'}" state="Information" />
                </VBox>
                <ObjectIdentifier title="{material}" text="{= ${plant} + ' / ' + ${order_type} }" />
                <ObjectNumber number="{order_quantity}" unit="{unit}" />
                <ObjectStatus text="{path: 'status', formatter: '.formatFriendlyOrderStatus'}" state="{path: 'status', formatter: '.formatState'}" />
                <VBox>
                  <Text
                    text="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'goods_receipt_status'}, {path: 'confirmationState>/version'}], formatter: '.formatWorkflowProgress'}"
                    wrapping="true" />
                  <ObjectStatus
                    text="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'goods_receipt_status'}, {path: 'confirmationState>/version'}], formatter: '.formatNextStep'}"
                    state="{parts: [{path: 'production_order'}, {path: 'status'}], formatter: '.formatNextStepState'}"
                    class="sapUiTinyMarginTop" />
                </VBox>
                <Button
                  text="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'material_document'}, {path: 'gr_material_document'}, {path: 'goods_receipt_status'}, {path: 'bapi_message'}, {path: 'confirmationState>/version'}], formatter: '.formatNextActionText'}"
                  icon="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'material_document'}, {path: 'gr_material_document'}, {path: 'goods_receipt_status'}, {path: 'bapi_message'}, {path: 'confirmationState>/version'}], formatter: '.formatNextActionIcon'}"
                  type="Emphasized"
                  class="workflowActionButton"
                  press="onExecuteNextStep"
                  visible="{parts: [{path: 'production_order'}, {path: 'status'}, {path: 'goods_issue_status'}, {path: 'material_document'}, {path: 'gr_material_document'}, {path: 'goods_receipt_status'}, {path: 'bapi_message'}, {path: 'confirmationState>/version'}], formatter: '.hasNextAction'}" />
                <Button text="View" icon="sap-icon://inspect" type="Transparent" press="onOpenProductionDetails" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        </ScrollContainer>

      </VBox>
    </content>

    <dependents>
      <Dialog id="productionDetailsDialog" title="Production Order Details" contentWidth="48rem" stretchOnPhone="true">
        <content>
          <VBox class="poDetailsContent">
            <ObjectHeader
              title="{= ${production_order} || 'Not created' }"
              intro="Production Order"
              number="{order_quantity}"
              numberUnit="{unit}">
              <statuses>
                <ObjectStatus text="{path: 'status', formatter: '.formatFriendlyOrderStatus'}" state="{path: 'status', formatter: '.formatState'}" />
              </statuses>
              <attributes>
                <ObjectAttribute title="Material" text="{material}" />
                <ObjectAttribute title="Plant" text="{plant}" />
                <ObjectAttribute title="Request ID" text="{request_id}" />
                <ObjectAttribute title="Planned Order" text="{planned_order}" />
              </attributes>
            </ObjectHeader>

            <Title text="SAP Document Flow" level="H4" class="sapUiSmallMarginTop" />
            <List showSeparators="Inner">
              <StandardListItem title="Goods Issue (261)" description="{= ${goods_issue_message} || 'Not posted' }" info="{material_document}" infoState="{path: 'goods_issue_status', formatter: '.formatGoodsIssueState'}" />
              <StandardListItem title="Production Goods Receipt (101)" description="{= ${goods_receipt_message} || 'Not posted' }" info="{gr_material_document}" infoState="{path: 'goods_receipt_status', formatter: '.formatGoodsReceiptState'}" />
            </List>

            <Title text="Processing Message" level="H4" class="sapUiSmallMarginTop" />
            <MessageStrip text="{= ${bapi_message} || 'No SAP processing message.' }" type="Information" showIcon="true" />
            <Text text="{path: 'created_at', formatter: '.formatDateTime'}" class="sapUiSmallMarginTop" />
          </VBox>
        </content>
        <endButton>
          <Button text="Close" press="onCloseProductionDetails" />
        </endButton>
      </Dialog>
    </dependents>
  </Page>
</mvc:View>
