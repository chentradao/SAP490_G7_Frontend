<mvc:View
    controllerName="sap490g7fioriapp.controller.MyOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page title="My Orders" showNavButton="true" navButtonPress=".onBack">
        <subHeader>
            <Toolbar>
                <Label text="From" labelFor="fromDate" />
                <DatePicker id="fromDate" valueFormat="yyyyMMdd" displayFormat="dd/MM/yyyy" change=".onFilterChange" class="sapUiTinyMarginBegin" />
                <Label text="To" labelFor="toDate" class="sapUiSmallMarginBegin" />
                <DatePicker id="toDate" valueFormat="yyyyMMdd" displayFormat="dd/MM/yyyy" change=".onFilterChange" class="sapUiTinyMarginBegin" />
                <ToolbarSpacer />
                <ToggleButton
                    text="{= ${orders>/showHidden} ? 'Show active orders' : 'Show hidden orders' }"
                    icon="sap-icon://hide"
                    pressed="{orders>/showHidden}"
                    press=".onToggleHiddenOrders"
                    class="sapUiTinyMarginEnd" />
                <ComboBox id="statusFilter" width="12rem" placeholder="Order status" selectionChange=".onFilterChange" items="{orders>/statusOptions}">
                    <core:Item key="{orders>key}" text="{orders>text}" />
                </ComboBox>
            </Toolbar>
        </subHeader>
        <content>
            <Table id="orderList" items="{orders>/filteredOrders}" noDataText="You do not have any orders yet" class="ordersTable">
                <columns>
                    <Column width="22%"><Text text="Order ID" /></Column>
                    <Column width="19%"><Text text="Created Date" /></Column>
                    <Column width="18%"><Text text="Order Status" /></Column>
                    <Column hAlign="End" width="19%"><Text text="Total Amount" /></Column>
                    <Column hAlign="Center" width="22%"><Text text="Actions" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier title="{orders>orderId}" text="{orders>paymentStatus}" />
                            <Text text="{orders>orderDateDisplay}" />
                            <ObjectStatus text="{orders>orderStatus}" state="{= ${orders>orderStatus} === 'COMPLETED' ? 'Success' : 'Information' }" />
                            <ObjectNumber number="{orders>totalAmountText}" unit="{orders>currency}" state="Success" class="orderAmount" />
                            <HBox justifyContent="Center">
                                <Button text="Details" type="Emphasized" press=".onOrderPress" />
                                <Button
                                    text="{= ${orders>isHidden} ? 'Restore' : 'Hide' }"
                                    icon="{= ${orders>isHidden} ? 'sap-icon://undo' : 'sap-icon://hide' }"
                                    type="{= ${orders>isHidden} ? 'Accept' : 'Reject' }"
                                    press=".onSoftDeleteOrder"
                                    class="sapUiTinyMarginBegin" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
