<mvc:View
    controllerName="sap490g7fioriapp.controller.FoodList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page title="{i18n>foodListTitle}" fitContainer="true">
        <headerContent>
            <Button id="cartButton" icon="sap-icon://cart" text="Cart" press=".onViewCart" />
            <Button id="ordersButton" icon="sap-icon://activity-items" text="My Orders" press=".onViewMyOrders" />
            <Button icon="sap-icon://log" text="{i18n>btnLogout}" press=".onLogout" />
        </headerContent>
        <subHeader>
            <Bar>
                <contentLeft>
                    <SearchField
                        id="foodSearchField"
                        width="16rem"
                        placeholder="{i18n>foodSearchPlaceholder}"
                        search=".onSearchFood"
                        liveChange=".onSearchFood" />
                </contentLeft>
                <contentMiddle>
                    <Select
                        id="quantitySort"
                        width="12rem"
                        selectedKey="None"
                        change=".onQuantitySortChange">
                        <core:Item key="None" text="Quantity sort" />
                        <core:Item key="Asc" text="Quantity: low to high" />
                        <core:Item key="Desc" text="Quantity: high to low" />
                    </Select>
                </contentMiddle>
                <contentRight>
                    <Select
                        id="statusFilter"
                        width="10rem"
                        selectedKey="All"
                        change=".onStatusChange">
                        <core:Item key="All" text="All Status" />
                        <core:Item key="1" text="Active" />
                        <core:Item key="0" text="Inactive" />
                    </Select>
                </contentRight>
            </Bar>
        </subHeader>
        <content>
            <Table
                id="foodTable"
                items="{
                    path: '/Food2',
                    sorter: { path: 'MaterialDescription' }
                }"
                noDataText="{i18n>msgNoFood}"
                growing="true"
                growingScrollToLoad="true">
                <columns>
                    <Column width="12rem">
                        <Text text="{i18n>colMaterialDescription}" />
                    </Column>
                    <Column width="9rem">
                        <Text text="{i18n>colMaterialGroup}" />
                    </Column>
                    <Column hAlign="End" width="8rem">
                        <Text text="{i18n>colAvailableStock}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>colPrice}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>colStatus}" />
                    </Column>
                    <Column width="8rem" hAlign="Center">
                        <Text text="" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onFoodPress">
                        <cells>
                            <ObjectIdentifier
                                title="{MaterialDescription}"
                                text="{MaterialNumber}" />
                            <Text text="{MaterialGroup}" />
                            <Text text="{= ${AvailableStock} !== null ? (${AvailableStock} + ' ' + ${BaseUnit}) : '' }" />
                            <Text text="{= ${Price} !== null ? (${Price} + ' ' + ${Currency}) : '' }" />
                            <ObjectStatus
                                text="{Status}"
                                state="{= ${Status} === 'ACTIVE' || ${Status} === '1' ? 'Success' : 'None' }" />
                            <Button text="Add to Cart" press=".onAddToCart" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
