<!-- View FoodList.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
    controllerName="sap490g7fioriapp.controller.FoodList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <!-- Trang chính: {i18n>foodListTitle} -->
    <Page title="{i18n>foodListTitle}" fitContainer="true">
        <headerContent>
            <Button id="cartButton" icon="sap-icon://cart" text="Cart" press=".onViewCart" />
            <Button id="ordersButton" icon="sap-icon://activity-items" text="My Orders" press=".onViewMyOrders" />
            <Button icon="sap-icon://log" text="{i18n>btnLogout}" press=".onLogout" />
        </headerContent>
        <subHeader>
            <Bar>
                <contentLeft>
                    <SearchField
                        id="foodSearchField"
                        width="16rem"
                        placeholder="{i18n>foodSearchPlaceholder}"
                        search=".onSearchFood"
                        liveChange=".onSearchFood" />
                </contentLeft>
                <contentMiddle>
                    <Select
                        id="quantitySort"
                        width="12rem"
                        selectedKey="None"
                        change=".onQuantitySortChange">
                        <core:Item key="None" text="Quantity sort" />
                        <core:Item key="Asc" text="Quantity: low to high" />
                        <core:Item key="Desc" text="Quantity: high to low" />
                    </Select>
                </contentMiddle>
            </Bar>
        </subHeader>
        <content>
            <Table
                id="foodTable"
                items="{
                    path: '/Food2',
                    filters: [{ path: 'Status', operator: 'EQ', value1: 'A' }],
                    sorter: { path: 'MaterialDescription' }
                }"
                noDataText="{i18n>msgNoFood}"
                growing="true"
                growingScrollToLoad="true">
                <columns>
                    <Column width="6rem" hAlign="Center">
                        <Text text="{i18n>colFoodImage}" />
                    </Column>
                    <Column width="12rem">
                        <Text text="{i18n>colMaterialDescription}" />
                    </Column>
                    <Column width="9rem">
                        <Text text="{i18n>colMaterialGroup}" />
                    </Column>
                    <Column hAlign="End" width="8rem">
                        <Text text="{i18n>colAvailableStock}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>colPrice}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>colStatus}" />
                    </Column>
                    <Column width="8rem" hAlign="Center">
                        <Text text="" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onFoodPress">
                        <cells>
                            <Avatar
                                src="{ImageUrl}"
                                fallbackIcon="sap-icon://meal"
                                displayShape="Square"
                                displaySize="Custom"
                                customDisplaySize="4rem"
                                customFontSize="1.5rem"
                                tooltip="{ImageUrl}"
                                class="foodListImage" />
                            <ObjectIdentifier
                                title="{MaterialDescription}"
                                text="{MaterialNumber}" />
                            <Text text="{MaterialGroup}" />
                            <Text text="{parts: [{path: 'AvailableStock'}, {path: 'BaseUnit'}], formatter: '.formatAvailableStock'}" />
                            <Text text="{parts: [{path: 'Price'}, {path: 'Currency'}], formatter: '.formatPrice'}" />
                            <ObjectStatus
                                text="{= %{Status} === 'A' ? %{i18n>statusActive} : %{i18n>statusInactive} }"
                                state="{= %{Status} === 'A' ? 'Success' : 'Error' }" />
                            <Button
                                text="Add to Cart"
                                enabled="{= %{Status} === 'A' &amp;&amp; %{AvailableStock} > 0 }"
                                press=".onAddToCart" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
