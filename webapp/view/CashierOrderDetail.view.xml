<!-- View CashierOrderDetail.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View
    controllerName="sap490g7fioriapp.controller.CashierOrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">

    <Page
        title="{= 'Order Detail - ' + (${orders>/selectedOrder/orderId} || '...')}"
        showNavButton="true"
        navButtonPress=".onBack"
        busy="{orders>/busy}"
        busyIndicatorDelay="0"
        class="sapUiContentPadding">

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    id="btnConfirm"
                    text="Confirm Order"
                    icon="sap-icon://accept"
                    type="Accept"
                    visible="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' }"
                    enabled="{= ${orders>/selectedOrder/orderStatus} === 'PENDING'
                               &amp;&amp; !${orders>/selectedOrder/hasStockIssue} }"
                    press=".onConfirmOrder" />
                <Button
                    id="btnCancel"
                    text="Cancel Order"
                    icon="sap-icon://sys-cancel-2"
                    type="Reject"
                    visible="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' }"
                    enabled="{= ${orders>/selectedOrder/orderStatus} === 'PENDING' }"
                    press=".onCancelOrder" />
            </OverflowToolbar>
        </footer>

        <content>
            <VBox>
                <Panel
                    headerText="Order Information"
                    expandable="false"
                    class="sapUiSmallMarginBottom">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Order Information" level="H3" />
                            <ToolbarSpacer />
                            <ObjectStatus
                                text="{= ${orders>/selectedOrder/orderStatus} === 'PENDING' ? 'Pending'
                                        : ${orders>/selectedOrder/orderStatus} === 'CONFIRMED' ? 'Confirmed'
                                        : ${orders>/selectedOrder/orderStatus} === 'CANCELLED' ? 'Cancelled'
                                        : ${orders>/selectedOrder/orderStatus} }"
                                icon="{= ${orders>/selectedOrder/orderStatus} === 'PENDING' ? 'sap-icon://time-overtime'
                                        : ${orders>/selectedOrder/orderStatus} === 'CONFIRMED' ? 'sap-icon://accept'
                                        : ${orders>/selectedOrder/orderStatus} === 'CANCELLED' ? 'sap-icon://sys-cancel-2'
                                        : 'sap-icon://status-inactive' }"
                                state="{= ${orders>/selectedOrder/orderStatus} === 'PENDING' ? 'Warning'
                                        : ${orders>/selectedOrder/orderStatus} === 'CONFIRMED' ? 'Success'
                                        : ${orders>/selectedOrder/orderStatus} === 'CANCELLED' ? 'Error'
                                        : 'None' }"
                                class="sapUiSmallMarginEnd" />
                            <ObjectStatus
                                text="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' ? 'Paid' : 'Unpaid' }"
                                icon="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' ? 'sap-icon://payment-approval' : 'sap-icon://pending' }"
                                state="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' ? 'Success' : 'Warning' }" />
                            <ObjectStatus
                                text="Insufficient Stock"
                                icon="sap-icon://alert"
                                state="Error"
                                visible="{orders>/selectedOrder/hasStockIssue}" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <f:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                        columnsXL="2" columnsL="2" columnsM="1"
                        class="sapUiSmallMargin">
                        <f:content>
                            <Label text="Order ID" />
                            <Text text="{orders>/selectedOrder/orderId}" />

                            <Label text="Customer" />
                            <Text text="{= ${orders>/selectedOrder/customerName} || ${orders>/selectedOrder/userId} || 'N/A' }" />

                            <Label text="Updated At" />
                            <Text text="{ path: 'orders>/selectedOrder/updatedAt', formatter: '.formatUpdatedAt' }" />

                            <Label text="Total Amount" />
                            <ObjectNumber
                                number="{ path: 'orders>/selectedOrder/totalAmount', formatter: '.formatAmount' }"
                                unit="{= ${orders>/selectedOrder/currency} || 'VND' }"
                                state="{= ${orders>/selectedOrder/paymentStatus} === 'PAID' ? 'Success' : 'Warning' }"
                                emphasized="true" />

                            <Label text="Note" />
                            <Text text="{= ${orders>/selectedOrder/note} || '-' }" />
                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <Panel
                    headerText="Order Items"
                    expandable="false">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Order Items" level="H3" />
                            <ToolbarSpacer />
                            <Text
                                text="{= 'Total: ' + ((${orders>/selectedOrder/items} || []).length) + ' items' }"
                                class="sapUiSmallMarginEnd" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <Table
                        id="itemsTable"
                        items="{orders>/selectedOrder/items}"
                        noDataText="No products in this order"
                        alternateRowColors="true"
                        sticky="HeaderToolbar,ColumnHeaders">
                        <columns>
                            <Column>
                                <Text text="Food" />
                            </Column>
                            <Column width="18rem">
                                <Text text="BOM" />
                            </Column>
                            <Column width="9rem" hAlign="Center">
                                <Text text="Quantity" />
                            </Column>
                            <Column width="9rem" hAlign="Center">
                                <Text text="Available" />
                            </Column>
                            <Column width="9rem" hAlign="End">
                                <Text text="Unit Price (VND)" />
                            </Column>
                            <Column width="10rem" hAlign="End">
                                <Text text="Line Amount (VND)" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier
                                        title="{orders>foodName}"
                                        text="{orders>foodId}" />
                                    <Text text="{orders>bomDisplay}" wrapping="true" />
                                    <Text text="{orders>quantity}" textAlign="Center" />
                                    <ObjectStatus
                                        text="{orders>availableDisplay}"
                                        state="{orders>stockState}" />
                                    <ObjectNumber
                                        number="{ path: 'orders>unitPrice', formatter: '.formatAmount' }"
                                        unit="VND" />
                                    <ObjectNumber
                                        number="{ path: 'orders>lineAmount', formatter: '.formatAmount' }"
                                        unit="VND"
                                        emphasized="true" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
