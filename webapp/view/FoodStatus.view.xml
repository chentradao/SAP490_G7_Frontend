<!-- View FoodStatus.view: định nghĩa bố cục UI, data binding và ánh xạ sự kiện sang controller tương ứng. -->
<mvc:View controllerName="sap490g7fioriapp.controller.FoodStatus"
    xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" displayBlock="true">
    <!-- Trang chính: Edit Food -->
    <Page title="Edit Food" showNavButton="true" navButtonPress=".onBack">
        <content>
          <VBox width="100%">
            <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiSmallMarginBegin sapUiSmallMarginEnd">
                <HBox alignItems="Center" wrap="Wrap">
                    <SearchField id="foodStatusSearch" width="24rem" placeholder="Search by food name or material number"
                        liveChange=".onSearch" search=".onSearch" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                    <Label text="Status" labelFor="foodStatusFilter" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                    <Select id="foodStatusFilter" width="10rem" selectedKey="ALL"
                        change=".onStatusFilterChange" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <core:Item key="ALL" text="All statuses" />
                        <core:Item key="A" text="Active" />
                        <core:Item key="I" text="Inactive" />
                    </Select>
                </HBox>
                <Button id="syncFGStockButton" text="Sync FG Stock" icon="sap-icon://synchronize"
                    type="Emphasized" press=".onSyncFGStock"
                    visible="{= %{session>/role} === 'ADMIN' }" class="sapUiTinyMarginBottom" />
            </HBox>
            <!-- Bảng dữ liệu: foodStatusTable -->
            <Table id="foodStatusTable" items="{path: '/Food2', sorter: {path: 'MaterialDescription'}}"
                growing="true" growingScrollToLoad="true" noDataText="No food items found">
                <columns>
                    <Column><Text text="Food" /></Column>
                    <Column width="10rem"><Text text="Category" /></Column>
                    <Column width="11rem" hAlign="End"><Text text="Available Stock" /></Column>
                    <Column width="10rem" hAlign="End"><Text text="Price" /></Column>
                    <Column width="9rem" hAlign="Center"><Text text="Status" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{MaterialDescription}" text="{MaterialNumber}" />
                            <Text text="{MaterialGroup}" />
                            <ObjectNumber number="{path: 'AvailableStock', formatter: '.formatQuantity'}" unit="{BaseUnit}" />
                            <ObjectNumber number="{path: 'Price', formatter: '.formatPrice'}" unit="{Currency}" />
                            <Switch state="{= %{Status} === 'A' }"
                                customTextOn="Active" customTextOff="Inactive" change=".onStatusChange" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
          </VBox>
        </content>
    </Page>
</mvc:View>
