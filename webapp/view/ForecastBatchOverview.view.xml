<mvc:View
  controllerName="sap490g7fioriapp.controller.ForecastBatchOverview"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="Forecast Batch Overview" showNavButton="true" navButtonPress="onNavBack" busy="{batchOverview>/busy}">
    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press="onRefresh" />
    </headerContent>

    <content>
      <VBox class="staffDashboardShell">
        <HBox class="staffDashboardHero" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox class="staffDashboardHeroText">
            <Title text="{batchOverview>/batchCode}" level="H1" />
            <Text text="Track one batch from Forecast and MRP through purchasing, receiving and production." />
          </VBox>
          <ObjectStatus text="{batchOverview>/status}" state="{batchOverview>/statusState}" icon="sap-icon://process" inverted="true" />
        </HBox>

        <Panel class="staffWorkflowPanel" headerText="Forecast Batch">
          <content>
            <OverflowToolbar>
              <Label text="Batch" labelFor="forecastBatchOverviewSelect" />
              <Select
                id="forecastBatchOverviewSelect"
                width="24rem"
                selectedKey="{batchOverview>/selectedBatchId}"
                items="{batchOverview>/batches}"
                change="onBatchChange">
                <core:Item key="{batchOverview>batchId}" text="{batchOverview>code}" />
              </Select>
              <ToolbarSeparator />
              <ObjectStatus title="Plant" text="{batchOverview>/plant}" state="Information" />
              <ObjectStatus title="Requirement Date" text="{batchOverview>/requirementDate}" state="Information" />
              <ToolbarSpacer />
              <Button text="{batchOverview>/nextActionText}" icon="sap-icon://navigation-right-arrow" type="Emphasized" press="onContinue" />
            </OverflowToolbar>
            <VBox class="sapUiSmallMargin">
              <Text text="Batch ID" />
              <ObjectIdentifier title="{batchOverview>/batchId}" />
              <ProgressIndicator
                percentValue="{batchOverview>/progress}"
                displayValue="{= ${batchOverview>/progress} + '% complete' }"
                state="{= ${batchOverview>/progress} === 100 ? 'Success' : 'Information' }"
                class="sapUiSmallMarginTop" />
            </VBox>
          </content>
        </Panel>

        <FlexBox wrap="Wrap" class="staffTileRow">
          <GenericTile header="1. Forecast / PIR" subheader="Demand captured" frameType="TwoByOne" press="onOpenForecasts">
            <tileContent>
              <TileContent footer="Completed forecasts">
                <NumericContent value="{batchOverview>/forecastCompleted}" scale="{= '/ ' + ${batchOverview>/forecastCount} }" icon="sap-icon://business-objects-experience" valueColor="Good" />
              </TileContent>
            </tileContent>
          </GenericTile>

          <GenericTile header="2. MRP Run" subheader="Planning execution" frameType="TwoByOne" press="onOpenMRPResults">
            <tileContent>
              <TileContent footer="{batchOverview>/mrpStatus}">
                <NumericContent value="{batchOverview>/purchaseCount}" scale="PR" icon="sap-icon://inventory" valueColor="Neutral" />
              </TileContent>
            </tileContent>
          </GenericTile>

          <GenericTile header="3. Purchasing / GR" subheader="Materials replenishment" frameType="TwoByOne" press="onOpenPurchaseOrders">
            <tileContent>
              <TileContent footer="{= ${batchOverview>/purchaseOrderCount} + ' PO · ' + ${batchOverview>/goodsReceiptCount} + ' GR' }">
                <NumericContent value="{batchOverview>/purchaseOrdered}" scale="{= '/ ' + ${batchOverview>/purchaseCount} }" icon="sap-icon://cart" valueColor="Critical" />
              </TileContent>
            </tileContent>
          </GenericTile>

          <GenericTile header="4. Production" subheader="Finished-goods processing" frameType="TwoByOne" press="onOpenProduction">
            <tileContent>
              <TileContent footer="{= ${batchOverview>/productionCreated} + ' created · ' + ${batchOverview>/productionCompleted} + ' completed' }">
                <NumericContent value="{batchOverview>/productionCompleted}" scale="{= '/ ' + ${batchOverview>/productionCount} }" icon="sap-icon://factory" valueColor="Critical" />
              </TileContent>
            </tileContent>
          </GenericTile>
        </FlexBox>

        <Panel class="staffWorkflowPanel" headerText="Workflow Progress">
          <content>
            <List showSeparators="Inner">
              <StandardListItem title="Forecast / PIR" description="{= ${batchOverview>/forecastCompleted} + ' of ' + ${batchOverview>/forecastCount} + ' ready' }" icon="sap-icon://business-objects-experience" type="Navigation" press="onOpenForecasts" />
              <StandardListItem title="MRP Run" description="{= ${batchOverview>/mrpStatus} + (${batchOverview>/latestMessage} ? ' · ' + ${batchOverview>/latestMessage} : '') }" icon="sap-icon://inventory" type="Navigation" press="onOpenMRPResults" />
              <StandardListItem title="Purchase Orders and Goods Receipt" description="{= ${batchOverview>/purchaseOrdered} + ' of ' + ${batchOverview>/purchaseCount} + ' PR ordered · ' + ${batchOverview>/goodsReceiptCount} + ' GR posted' }" icon="sap-icon://cart" type="Navigation" press="onOpenPurchaseOrders" />
              <StandardListItem title="Production" description="{= ${batchOverview>/productionCompleted} + ' of ' + ${batchOverview>/productionCount} + ' completed' }" icon="sap-icon://factory" type="Navigation" press="onOpenProduction" />
            </List>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
